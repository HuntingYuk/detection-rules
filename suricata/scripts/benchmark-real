#!/usr/bin/env python3
"""benchmark-real — run our ruleset AND ET Open against real-world pcaps
(malware-traffic-analysis.net captures or your own perimeter capture). Reports
per-pcap which rules fired on each side — no per-flow attribution gymnastics,
because real pcaps have many flows / many client IPs.

What we measure (honest):
  - For each ATTACK pcap (real malware capture):
    * Which of OUR rules fire? (coverage signal: do we catch real attacks?)
    * Which ET Open rules fire? (control)
    * Cross-comparison: rule families we cover, families ET covers,
      and the union (= what each side actually sees in the wild)
  - For each BENIGN pcap (background/legit traffic):
    * Any of our rules fire? = REAL false-positive candidates
    * (Caveat: real pcaps usually have some scan/probe noise — note that
      a "FP candidate" in benign might actually be a real probe we caught.)

Output: AUDIT-REAL.md (committed snapshot, regenerable).
"""
import os, re, sys, json, glob, shutil, subprocess, tempfile, argparse, collections

SUR  = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ROOT = os.path.dirname(SUR)
RULES = os.path.join(SUR, "rules")
CFG  = os.path.join(SUR, "config", "suricata-test.yaml")
ETDIR = os.path.join(ROOT, "reference", "et-open")
OUT_MD = os.path.join(SUR, "AUDIT-REAL.md")

def die(m): print("ERROR: "+m, file=sys.stderr); sys.exit(1)

def _combined_ours(td):
    files = sorted(glob.glob(os.path.join(RULES, "**", "*.rules"), recursive=True))
    p = os.path.join(td, "_ours.rules")
    with open(p, "w") as o:
        for f in files: o.write(open(f).read().rstrip()+"\n")
    return p

def _et_yaml(td):
    y = open(CFG).read()
    y = y.replace('default-rule-path: rules', 'default-rule-path: '+ETDIR)
    y = re.sub(r'rule-files:\n(?:  - .*\n)+', 'rule-files:\n  - suricata.rules\n', y)
    y = y.replace('classification-file: config/classification.config',
                  'classification-file: '+os.path.join(ETDIR, 'classification.config'))
    p = os.path.join(td, "et.yaml"); open(p, "w").write(y); return p

def _our_msgs():
    out = {}
    for f in glob.glob(os.path.join(RULES, "**", "*.rules"), recursive=True):
        for ln in open(f, errors="replace"):
            if re.match(r'^\s*alert\b', ln):
                sm = re.search(r'\bsid:(\d+)', ln); mm = re.search(r'\bmsg:"([^"]*)"', ln)
                if sm: out[int(sm.group(1))] = mm.group(1) if mm else ""
    return out

def _et_msgs():
    out = {}
    p = os.path.join(ETDIR, "suricata.rules")
    if not os.path.exists(p): return out
    for ln in open(p, errors="replace"):
        s = ln.strip()
        if s.startswith("#"): continue
        sm = re.search(r'\bsid:(\d+)', ln); mm = re.search(r'\bmsg:"([^"]*)"', ln)
        if sm: out[int(sm.group(1))] = mm.group(1) if mm else ""
    return out

def _run(suri, pcap, td, mode="ours", ours_S=None, et_yaml=None):
    out = tempfile.mkdtemp(dir=td)
    if mode == "ours":
        cmd = [suri, "-k", "none", "-l", out, "-r", pcap, "-c", CFG, "-S", ours_S]
    else:
        cmd = [suri, "-k", "none", "-l", out, "-r", pcap, "-c", et_yaml]
    subprocess.run(cmd, cwd=SUR, capture_output=True)
    fired = collections.Counter()
    ev = os.path.join(out, "eve.json")
    if os.path.exists(ev):
        for line in open(ev):
            try:
                j = json.loads(line)
                if j.get("event_type") == "alert":
                    fired[int(j["alert"]["signature_id"])] += 1
            except Exception: pass
    shutil.rmtree(out, ignore_errors=True)
    return fired

def main():
    ap = argparse.ArgumentParser(prog="benchmark-real")
    ap.add_argument("--pcap-dir", required=True, help="dir of attack/malware pcaps")
    ap.add_argument("--benign-dir", default=None, help="dir of benign pcaps (optional)")
    ap.add_argument("--no-et", action="store_true", help="skip ET Open control")
    a = ap.parse_args()

    suri = shutil.which("suricata") or die("suricata not on PATH")
    attack_pcaps = sorted(glob.glob(os.path.join(a.pcap_dir, "*.pcap")))
    if not attack_pcaps: die(f"no .pcap in {a.pcap_dir}")
    benign_pcaps = sorted(glob.glob(os.path.join(a.benign_dir, "*.pcap"))) if a.benign_dir else []
    have_et = os.path.exists(os.path.join(ETDIR, "suricata.rules")) and not a.no_et

    our_msg = _our_msgs(); et_msg = _et_msgs() if have_et else {}
    td = tempfile.mkdtemp(prefix="_real_")
    try:
        oS = _combined_ours(td)
        ey = _et_yaml(td) if have_et else None

        atk_report = []   # list of dicts per pcap
        for pf in attack_pcaps:
            name = os.path.basename(pf)
            size = os.path.getsize(pf) // 1024
            print(f"  attack: {name} ({size} KB)")
            ours = _run(suri, pf, td, "ours", oS)
            et   = _run(suri, pf, td, "et", et_yaml=ey) if have_et else collections.Counter()
            atk_report.append(dict(name=name, size_kb=size, ours=ours, et=et))
            print(f"    -> our sids fired: {len(ours)}  ({sum(ours.values())} alerts)"
                  + (f" | ET sids fired: {len(et)}  ({sum(et.values())} alerts)" if have_et else ""))

        ben_report = []
        for pf in benign_pcaps:
            name = os.path.basename(pf)
            size = os.path.getsize(pf) // 1024
            print(f"  benign: {name} ({size} KB)")
            ours = _run(suri, pf, td, "ours", oS)
            ben_report.append(dict(name=name, size_kb=size, ours=ours))
            print(f"    -> our sids fired on benign: {len(ours)} (FP candidates)")

        # ----- write markdown report -----
        L = ["# AUDIT-REAL.md — ruleset vs real-world pcap traffic", "",
             "> Auto-generated by `scripts/benchmark-real`. Pcaps from "
             "[malware-traffic-analysis.net](https://www.malware-traffic-analysis.net) "
             "(Brad Duncan, daily real-malware captures) and/or your own perimeter "
             "captures (`reference/mta/` + `reference/<custom>/` are gitignored).", "",
             "## Headline", "",
             f"- Attack pcaps analysed: **{len(attack_pcaps)}**",
             f"- Benign pcaps analysed: {len(benign_pcaps)}",
             f"- ET Open control: **{'enabled' if have_et else 'disabled'}**",
             ""]
        total_alerts_ours = sum(sum(r['ours'].values()) for r in atk_report)
        total_alerts_et   = sum(sum(r['et'].values())   for r in atk_report) if have_et else 0
        our_sids_overall = set()
        et_sids_overall = set()
        for r in atk_report:
            our_sids_overall.update(r['ours']); et_sids_overall.update(r['et'])
        L += [f"- Total alerts from OUR ruleset on attack corpus: **{total_alerts_ours}** "
              f"({len(our_sids_overall)} distinct SIDs)",
              ""]
        if have_et:
            L += [f"- Total alerts from ET Open on attack corpus: {total_alerts_et} "
                  f"({len(et_sids_overall)} distinct SIDs)",
                  ""]

        L += ["## Per-attack-pcap coverage", ""]
        for r in atk_report:
            L += [f"### `{r['name']}` ({r['size_kb']} KB)", ""]
            # OUR
            if r['ours']:
                L += ["**Our rules fired:**", ""]
                for sid, ct in sorted(r['ours'].items(), key=lambda x:-x[1]):
                    L.append(f"- {sid} × **{ct}** — {our_msg.get(sid,'?')[:100]}")
                L.append("")
            else:
                L += ["**Our rules fired:** _(none)_", ""]
            # ET
            if have_et:
                if r['et']:
                    top = sorted(r['et'].items(), key=lambda x:-x[1])[:10]
                    L += [f"**ET Open fired:** ({len(r['et'])} distinct SIDs, top 10)", ""]
                    for sid, ct in top:
                        L.append(f"- {sid} × {ct} — {et_msg.get(sid,'?')[:100]}")
                    if len(r['et']) > 10:
                        L.append(f"- _...and {len(r['et'])-10} more_")
                    L.append("")
                else:
                    L += ["**ET Open fired:** _(none)_", ""]

        if benign_pcaps:
            L += ["---", "", "## Benign-pcap FP candidates", ""]
            for r in ben_report:
                L += [f"### `{r['name']}` ({r['size_kb']} KB)", ""]
                if r['ours']:
                    L += ["**Our rules fired on benign (REAL FP CANDIDATES — review):**", ""]
                    for sid, ct in sorted(r['ours'].items(), key=lambda x:-x[1]):
                        L.append(f"- {sid} × **{ct}** — {our_msg.get(sid,'?')[:100]}")
                else:
                    L += ["_(none — clean on this benign capture)_", ""]
                L.append("")

        L += ["---", "",
              "**Honest reading**: real malware pcaps mix the *actual* attack flows "
              "(payload/C2/exfil) with background protocol traffic (DNS, NTP, TLS "
              "handshakes to update servers, etc.). Rules firing here = both genuine "
              "detection AND incidental scan/anomaly hits. Per-pcap rule msgs above let "
              "you triage which is which. Benign-pcap FP signal is more authoritative.",
              "",
              "**Behavioural cross-reference**: MTA writeups at the pcap's source URL "
              "describe the malware family/behaviour — use that to map our SIDs back to "
              "real-world attack patterns and seed CLEAN-ROOM new rules (CLAUDE.md §13)."]
        open(OUT_MD, "w").write("\n".join(L) + "\n")
        print(f"\nwrote {os.path.relpath(OUT_MD, ROOT)}")
    finally:
        shutil.rmtree(td, ignore_errors=True)

if __name__ == "__main__":
    main()
