#!/usr/bin/env python3
"""gen-manifest — emit a manifest of EVERY rule + all metadata + file paths.
Split into:

  rules.json                    — index file (corpus stats + lightweight
                                  per-rule entries + pointers to detail)
  rules/by-category/<cat>.json  — full per-rule detail (one file per category)

This keeps `rules.json` small (~30 KB) and lets downstream tools fetch only
the category they need. Each rule's index entry includes `ref` pointing to
its detail file (`rules/by-category/<cat>.json`).

Per-rule (in detail file): sid, rev, enabled, file, msg, classtype, category,
metadata (all controlled-vocab keys), fast_pattern (content + nocase),
has_pcre, pcre, has_detection_filter, has_threshold, buffers, poc_dir,
readme, description (attack/impact/detects), bench_status_§17, raw.

`--check` (used by `rulectl ci`) re-runs the manifest generation in-memory
and fails on any drift (missing/stale/orphan) vs on-disk files.
"""
import os, re, sys, json, glob, datetime

SUR  = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ROOT = os.path.dirname(SUR)
RULES = os.path.join(SUR, "rules")
TESTS = os.path.join(SUR, "tests", "poc")
DESC  = os.path.join(TESTS, "_descriptions.json")
BENCH = os.path.join(TESTS, "_bench_status.json")
OUT_INDEX = os.path.join(ROOT, "rules.json")
OUT_DIR   = os.path.join(ROOT, "rules")
OUT_BYCAT = os.path.join(OUT_DIR, "by-category")

KNOWN_BUFFERS = ["http.uri.raw","http.uri","http.request_body","http.response_body",
                 "http.header","http.cookie","http.user_agent","http.method",
                 "tls.sni","ja3.hash","ja4.hash","dns.query","file.data"]

def _parse_metadata(ln):
    m = re.search(r'\bmetadata:\s*([^;]+);', ln)
    if not m: return {}
    out = {}
    for pair in m.group(1).split(","):
        pair = pair.strip()
        if not pair or " " not in pair: continue
        k, _, v = pair.partition(" ")
        out[k] = v.strip()
    return out

def _parse_rule(line, file_path):
    sid_m  = re.search(r'\bsid:(\d+)', line)
    rev_m  = re.search(r'\brev:(\d+)', line)
    msg_m  = re.search(r'\bmsg:"([^"]*)"', line)
    cls_m  = re.search(r'\bclasstype:([\w-]+)', line)
    if not sid_m: return None

    fp = None
    for cm in re.finditer(r'content:"([^"]*)"', line):
        tail = line[cm.end():cm.end()+40]
        if "fast_pattern" in tail:
            fp = {"content": cm.group(1),
                  "nocase": ("nocase" in line[cm.start():cm.end()+40])}
            break
    if fp is None:
        cm = re.search(r'content:"([^"]*)"', line)
        if cm:
            fp = {"content": cm.group(1),
                  "nocase": ("nocase" in line[cm.start():cm.end()+40]),
                  "implicit": True}

    pcre_m = re.search(r'pcre:"([^"]*)"', line)
    buffers = [b for b in KNOWN_BUFFERS if (b+";") in line or (b+" ") in line]

    md = _parse_metadata(line)
    poc_ref = md.get("poc_ref", "")
    poc_dir = ""; readme = ""
    if poc_ref:
        d = os.path.dirname(poc_ref)
        poc_dir = "suricata/" + d + "/"
        readme = "suricata/" + d + "/README.md"

    return {
        "sid": int(sid_m.group(1)),
        "rev": int(rev_m.group(1)) if rev_m else 1,
        "enabled": True,
        "file": os.path.relpath(file_path, ROOT),
        "msg": msg_m.group(1) if msg_m else "",
        "classtype": cls_m.group(1) if cls_m else "",
        "category": os.path.basename(file_path).replace(".rules", ""),
        "metadata": md,
        "fast_pattern": fp,
        "has_pcre": pcre_m is not None,
        "pcre": pcre_m.group(1) if pcre_m else None,
        "has_detection_filter": "detection_filter:" in line,
        "has_threshold": "threshold:" in line,
        "buffers": buffers,
        "poc_dir": poc_dir,
        "readme": readme,
        "raw": line.rstrip("\n"),
    }

def _build():
    desc = json.load(open(DESC)) if os.path.exists(DESC) else {}
    bench = json.load(open(BENCH)) if os.path.exists(BENCH) else {}

    rules = []
    for f in sorted(glob.glob(os.path.join(RULES, "**", "*.rules"), recursive=True)):
        for ln in open(f, errors="replace"):
            stripped = ln.strip()
            is_active   = bool(re.match(r'^\s*alert\b', ln))
            is_deprecated = stripped.startswith("# alert")
            if not (is_active or is_deprecated): continue
            line = stripped[2:] if is_deprecated else ln
            r = _parse_rule(line if is_active else line, f)
            if not r: continue
            r["enabled"] = is_active
            sid_str = str(r["sid"])
            r["description"] = desc.get(sid_str) if sid_str in desc else None
            r["bench_status_§17"] = bench.get(sid_str)
            rules.append(r)

    active = [r for r in rules if r["enabled"]]
    rules.sort(key=lambda r: r["sid"])

    by_cat = {}
    for r in rules: by_cat.setdefault(r["category"], []).append(r)

    cnt_cat = {k: sum(1 for r in v if r["enabled"]) for k,v in by_cat.items()}
    def count_meta(key):
        d = {}
        for r in active:
            v = r["metadata"].get(key, "?")
            d[v] = d.get(v,0)+1
        return dict(sorted(d.items()))
    corpus = {
        "total":           len(rules),
        "active":          len(active),
        "deprecated":      len(rules) - len(active),
        "by_category":     dict(sorted(cnt_cat.items())),
        "by_owasp":        count_meta("owasp"),
        "by_confidence":   count_meta("confidence"),
        "by_network_mode": count_meta("network_mode"),
        "bench_§17_summary": {
            "GAP":     sum(1 for r in active if r["bench_status_§17"] == "GAP"),
            "OVERLAP": sum(1 for r in active if r["bench_status_§17"] == "OVERLAP"),
            "unmeasured": sum(1 for r in active if r["bench_status_§17"] is None),
        },
    }

    now = datetime.datetime.utcnow().replace(microsecond=0).isoformat() + "Z"

    files = {}
    bycat_pointers = {}
    for cat in sorted(by_cat):
        path = os.path.join(OUT_BYCAT, f"{cat}.json")
        rel  = os.path.relpath(path, ROOT)
        bycat_pointers[cat] = rel
        files[path] = json.dumps({
            "$schema":      "1.0",
            "generated_at": now,
            "category":     cat,
            "rules":        sorted(by_cat[cat], key=lambda r: r["sid"]),
        }, indent=2, ensure_ascii=False) + "\n"

    index_rules = []
    for r in rules:
        index_rules.append({
            "sid":              r["sid"],
            "rev":              r["rev"],
            "enabled":          r["enabled"],
            "category":         r["category"],
            "file":             r["file"],
            "msg":              r["msg"],
            "owasp":            r["metadata"].get("owasp","?"),
            "confidence":       r["metadata"].get("confidence","?"),
            "network_mode":     r["metadata"].get("network_mode","?"),
            "cve":              r["metadata"].get("cve","none"),
            "bench_status_§17": r["bench_status_§17"],
            "poc_dir":          r["poc_dir"],
            "ref":              bycat_pointers[r["category"]],
        })
    files[OUT_INDEX] = json.dumps({
        "$schema":      "1.0",
        "generated_at": now,
        "source":       "HuntingYuk detection-rules — scripts/gen-manifest",
        "corpus":       corpus,
        "split": {
            "by_category": bycat_pointers,
            "schema": "rules.json = lightweight index (THIS FILE); "
                      "rules/by-category/<cat>.json = full per-rule detail "
                      "(metadata, fast_pattern, pcre, buffers, poc_dir, "
                      "readme, description, raw alert line).",
        },
        "rules_index": index_rules,
    }, indent=2, ensure_ascii=False) + "\n"

    return files

def _stable(s):
    return re.sub(r'"generated_at":\s*"[^"]+"', '"generated_at": "STABLE"', s)

def main():
    files = _build()
    if "--check" in sys.argv:
        bad = []
        for p, want in files.items():
            if not os.path.exists(p):
                bad.append(("missing", os.path.relpath(p, ROOT))); continue
            cur = open(p).read()
            if _stable(cur) != _stable(want):
                bad.append(("stale", os.path.relpath(p, ROOT)))
        existing = set(glob.glob(os.path.join(OUT_BYCAT, "*.json")))
        wanted = set(p for p in files if p.startswith(OUT_BYCAT))
        for p in existing - wanted:
            bad.append(("orphan", os.path.relpath(p, ROOT)))
        if bad:
            print("gen-manifest --check: %d issue(s) — run scripts/gen-manifest" % len(bad),
                  file=sys.stderr)
            for kind, p in bad: print(f"  [{kind}] {p}", file=sys.stderr)
            sys.exit(1)
        print(f"gen-manifest --check: rules.json + {len([p for p in files if p != OUT_INDEX])} category files up to date.")
        return
    os.makedirs(OUT_BYCAT, exist_ok=True)
    existing = set(glob.glob(os.path.join(OUT_BYCAT, "*.json")))
    wanted = set(p for p in files if p.startswith(OUT_BYCAT))
    for p in existing - wanted:
        os.remove(p); print(f"  removed orphan: {os.path.relpath(p, ROOT)}")
    for p, content in files.items():
        os.makedirs(os.path.dirname(p), exist_ok=True)
        open(p, "w").write(content)
    total_size = sum(os.path.getsize(p) for p in files)
    cat_files = [p for p in files if p != OUT_INDEX]
    print(f"wrote rules.json ({os.path.getsize(OUT_INDEX)} B) + "
          f"{len(cat_files)} category files in rules/by-category/ "
          f"({total_size} B total).")

if __name__ == "__main__":
    main()
