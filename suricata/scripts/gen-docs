#!/usr/bin/env python3
"""gen-docs — single source of human docs for the ruleset.

Reads tests/poc/_descriptions.json (plain-language: attack/impact/detects per
SID) + each rule's own metadata, then GENERATES:
  - tests/poc/<sid>_<slug>/README.md   (1:1 with each active rule)
  - CATALOG.md                          (repo-root, one browsable table)

The generated READMEs are NOT hand-edited — edit _descriptions.json and re-run.
`gen-docs --check` (used by `rulectl ci`) fails if an active rule has no
description entry or if any generated file is stale (drift gate).

§17 column: read from tests/poc/_bench_status.json if present
(`scripts/benchmark --emit-status tests/poc/_bench_status.json`), else "-".
"""
import os, re, sys, json, glob

SUR   = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ROOT  = os.path.dirname(SUR)
RULES = os.path.join(SUR, "rules")
POC   = os.path.join(SUR, "tests", "poc")
DESC  = os.path.join(POC, "_descriptions.json")
BST   = os.path.join(POC, "_bench_status.json")
CAT   = os.path.join(ROOT, "CATALOG.md")

GEN_NOTE = ("> Auto-generated by `scripts/gen-docs` from "
            "`tests/poc/_descriptions.json` + rule metadata. **Jangan edit di "
            "sini** — edit JSON-nya lalu jalankan `scripts/gen-docs`.")

def _rules():
    """Yield dict per rule line (active + deprecated) in file order."""
    out = []
    for f in sorted(glob.glob(os.path.join(RULES, "**", "*.rules"), recursive=True)):
        rel = os.path.relpath(f, SUR)
        for ln in open(f, errors="replace"):
            s = ln.strip()
            active = bool(re.match(r'^\s*alert\b', ln))
            dep = s.startswith("# alert") or s.startswith("# DEPRECATED")
            if not (active or s.startswith("# alert")):
                continue
            g = lambda k: (re.search(k, ln) or [None, ""])[1] if re.search(k, ln) else ""
            sid = g(r'\bsid:(\d+)')
            if not sid:
                continue
            msg = g(r'\bmsg:"([^"]*)"')
            out.append(dict(
                sid=sid, file=rel, msg=msg,
                owasp=g(r'\bowasp (\S+?),'), sev=g(r'\bsignature_severity (\w+)'),
                conf=g(r'\bconfidence (\w+)'), nm=g(r'\bnetwork_mode (\w+)'),
                side="client" if "flow:established,to_client" in ln else "server",
                poc=g(r'\bpoc_ref (\S+?/poc\.(?:sh|py))'),
                active=active and not dep))
    return out

def _title(msg):
    return re.sub(r'\s*\[(?:high|medium|low)\]\s*$', '', msg).strip() or "(no msg)"

def _readme(r, d):
    side = " · **Side:** response (to_client)" if r["side"] == "client" else ""
    return """# SID {sid} — {title}

{note}

**Rule:** `{file}` · **Confidence:** {conf} · **OWASP:** {owasp} · **Severity:** {sev} · **Network:** {nm}{side}

## Serangan apa ini?
{attack}

## Kalau kena, dampaknya?
{impact}

## Apa yang rule ini deteksi?
{detects}

## PoC vs Negative
- `poc.sh` → **harus** memicu SID {sid}.
- `negative.sh` → lookalike jinak; kena fast_pattern lalu **ditolak pcre** → TIDAK alert (§19 T6).

## Cara jalanin
```
scripts/rulectl check {sid}
```
""".format(sid=r["sid"], title=_title(r["msg"]), note=GEN_NOTE, file=r["file"],
           conf=r["conf"] or "-", owasp=r["owasp"] or "none", sev=r["sev"] or "-",
           nm=r["nm"] or "-", side=side,
           attack=d["attack"], impact=d["impact"], detects=d["detects"])

def _catalog(rules, desc, bst):
    act = [r for r in rules if r["active"]]
    dep = [r for r in rules if not r["active"]]
    L = ["# Katalog Deteksi (CATALOG)", "",
         GEN_NOTE.replace("Jangan edit di sini", "Jangan edit file ini"), "",
         "**%d rule aktif**, %d deprecated. Kolom **§17**: status vs kontrol "
         "ET Open (GAP = hanya ruleset kita yang nangkap = nilai-tambah; "
         "OVERLAP = ET juga nangkap; `-` = belum diukur). Penjelasan lengkap "
         "tiap rule ada di `tests/poc/<sid>_<slug>/README.md`." % (len(act), len(dep)),
         ""]
    bycat = {}
    for r in act:
        bycat.setdefault(os.path.basename(r["file"]), []).append(r)
    for cat in sorted(bycat):
        L += ["## %s" % cat, "",
              "| SID | Serangan | OWASP | Sev | Conf | Net | §17 |",
              "|-----|----------|-------|-----|------|-----|-----|"]
        for r in sorted(bycat[cat], key=lambda x: x["sid"]):
            L.append("| %s | %s | %s | %s | %s | %s | %s |" % (
                r["sid"], _title(r["msg"]).replace("|", "/"),
                (r["owasp"] or "none").replace("-", " "), r["sev"] or "-",
                r["conf"] or "-", r["nm"] or "-", bst.get(r["sid"], "-")))
        L.append("")
    if dep:
        L += ["## Deprecated (di luar jalur deteksi — lihat `config/deprecated.log`)", "",
              "| SID | (dulu) |", "|-----|--------|"]
        seen = set()
        for r in dep:
            if r["sid"] in seen:
                continue
            seen.add(r["sid"])
            L.append("| %s | %s |" % (r["sid"], _title(r["msg"]).replace("|", "/")))
        L.append("")
    return "\n".join(L)

def main():
    check = "--check" in sys.argv
    desc = json.load(open(DESC))
    bst = json.load(open(BST)) if os.path.exists(BST) else {}
    rules = _rules()
    active = [r for r in rules if r["active"]]

    missing = sorted(r["sid"] for r in active
                     if r["sid"] not in desc and r["sid"] != "_README")
    if missing:
        print("gen-docs: %d active rule(s) have NO _descriptions.json entry: %s"
              % (len(missing), ", ".join(missing)), file=sys.stderr)
        if check:
            sys.exit(1)

    planned = {}
    for r in active:
        if r["sid"] not in desc or not r["poc"]:
            continue
        d = desc[r["sid"]]
        path = os.path.join(SUR, os.path.dirname(r["poc"]), "README.md")
        planned[path] = _readme(r, d)
    planned[CAT] = _catalog(rules, desc, bst)

    drift = [p for p, c in planned.items()
             if not (os.path.exists(p) and open(p).read() == c)]
    if check:
        if drift:
            print("gen-docs: %d doc(s) stale — run scripts/gen-docs:\n  %s"
                  % (len(drift), "\n  ".join(os.path.relpath(p, ROOT) for p in sorted(drift))),
                  file=sys.stderr)
            sys.exit(1)
        print("gen-docs --check: %d README + CATALOG.md up to date, "
              "%d active rules all described." % (len(planned) - 1, len(active)))
        return
    for p, c in planned.items():
        os.makedirs(os.path.dirname(p), exist_ok=True)
        open(p, "w").write(c)
    print("gen-docs: wrote %d README + CATALOG.md (%d active rules described%s)."
          % (len(planned) - 1, len(active),
             "" if not missing else "; %d MISSING desc" % len(missing)))

if __name__ == "__main__":
    main()
