# FP-reasoning: MEDIUM, network_mode=any (pure L3/L4, no decryption needed).
# NON-payload class (spec §22 C1): NO fast_pattern by design — the decisive
# condition is "many bare-SYN connection attempts from one source in a short
# window". flags:S,12 = SYN set, ignore ECN/CWR, ACK unset (a connection attempt,
# not an established data flow). threshold count 60/10s by_src is the FP
# compensator: normal clients open far fewer; a NAT/proxy burst is the main residual
# FP and is accepted as recon-grade (classtype attempted-recon, alert-only).
# Negative exercises the decisive condition: a handful of SYNs from one src
# (normal browsing) -> below threshold -> silent.
alert tcp any any -> any any (msg:"REDAC7D RECON TCP SYN port-scan - high SYN rate from one source [medium]"; flow:to_server; flags:S,12; threshold:type threshold, track by_src, count 60, seconds 10; classtype:attempted-recon; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1046, mitre_technique_name Network-Service-Discovery, kill_chain Recon, confidence medium, signature_severity Minor, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9420001_syn-portscan/poc.sh, tag port-scan, created_at 2026_05_18, updated_at 2026_05_18, author redac7d; sid:9420001; rev:1;)
