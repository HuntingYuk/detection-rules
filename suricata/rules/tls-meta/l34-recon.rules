# FP-reasoning: MEDIUM, network_mode=any (pure L3/L4, no decryption). NON-payload
# class (spec §22 C1): NO fast_pattern; decisive condition is a rate of recon
# probes from one source. threshold counts are the FP compensator. Negatives
# exercise the same decisive surface at a benign volume -> silent.
alert tcp any any -> any any (msg:"RECON TCP SYN port-scan - high SYN rate from one source [medium]"; flow:to_server; flags:S,12; threshold:type threshold, track by_src, count 60, seconds 10; classtype:attempted-recon; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1046, mitre_technique_name Network-Service-Discovery, kill_chain Recon, confidence medium, signature_severity Minor, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9420001_syn-portscan/poc.sh, tag port-scan, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9420001; rev:1;)
alert icmp any any -> any any (msg:"RECON ICMP echo sweep - high echo-request rate from one source [medium]"; itype:8; threshold:type threshold, track by_src, count 30, seconds 10; classtype:attempted-recon; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1018, mitre_technique_name Remote-System-Discovery, kill_chain Recon, confidence medium, signature_severity Minor, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9420002_icmp-sweep/poc.sh, tag icmp-sweep, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9420002; rev:1;)
# FP-reasoning: MEDIUM, any, L3/L4, NON-payload. Many UDP datagrams from one src to
# many distinct dports in a short window = UDP port sweep. threshold 50/10s by_src is
# the FP compensator (normal apps don't fan out like this). Negative: a few UDP
# packets (e.g. DNS/NTP) from one src -> below threshold -> silent.
alert udp any any -> any any (msg:"RECON UDP port sweep - high UDP rate to many ports from one source [medium]"; threshold:type threshold, track by_src, count 50, seconds 10; classtype:attempted-recon; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1046, mitre_technique_name Network-Service-Discovery, kill_chain Recon, confidence medium, signature_severity Minor, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9420003_udp-port-sweep/poc.sh, tag port-scan, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9420003; rev:1;)
# FP-reasoning: MEDIUM, any, L3/L4, NON-payload. ICMP Timestamp Request (type 13)
# is legacy host-discovery/OS-recon rarely emitted by modern legit hosts; a rate of
# them from one src = sweep. threshold 10/60s by_src compensates the odd monitoring
# probe. Negative: a few type-13 (rare mgmt) below threshold -> silent.
alert icmp any any -> any any (msg:"RECON ICMP Timestamp Request sweep (legacy host discovery) [medium]"; itype:13; threshold:type threshold, track by_src, count 10, seconds 60; classtype:attempted-recon; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1018, mitre_technique_name Remote-System-Discovery, kill_chain Recon, confidence medium, signature_severity Minor, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9420004_icmp-timestamp-recon/poc.sh, tag icmp-recon, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9420004; rev:1;)
