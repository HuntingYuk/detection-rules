# FP-reasoning: HIGH, network_mode=any (pure L3/L4). NON-payload (spec §22 C1): no
# fast_pattern; decisive condition = an illegal TCP flag combination that no
# legitimate stack emits -> attacker-unique scan/evasion. Single-event.
alert tcp any any -> any any (msg:"PROTO-ANOMALY illegal TCP flags SYN+FIN (scan/evasion) [high]"; flow:to_server; flags:SF; classtype:protocol-command-decode; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1046, mitre_technique_name Network-Service-Discovery, kill_chain Recon, confidence high, signature_severity Minor, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9500001_tcp-syn-fin/poc.sh, tag tcp-flags-anomaly, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9500001; rev:1;)
alert tcp any any -> any any (msg:"PROTO-ANOMALY TCP Xmas scan (FIN+PSH+URG) [high]"; flow:to_server; flags:FPU; classtype:protocol-command-decode; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1046, mitre_technique_name Network-Service-Discovery, kill_chain Recon, confidence high, signature_severity Minor, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9500002_tcp-xmas/poc.sh, tag tcp-flags-anomaly, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9500002; rev:1;)
# FP-reasoning: HIGH, any, L3/L4, NON-payload (no fast_pattern). A TCP packet with ZERO flag bits set never occurs in a legitimate TCP stack -> attacker-unique NULL scan. Single-event. Negative: a normal SYN (S set) exercises the same TCP-flags surface but is legal -> silent.
alert tcp any any -> any any (msg:"PROTO-ANOMALY TCP NULL scan (no flags set) [high]"; flags:0; classtype:protocol-command-decode; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1046, mitre_technique_name Network-Service-Discovery, kill_chain Recon, confidence high, signature_severity Minor, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9500003_tcp-null-scan/poc.sh, tag tcp-flags-anomaly, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9500003; rev:1;)
# FP-reasoning: MEDIUM, any, L3/L4, NON-payload. ICMP echo carrying a >1024B data
# payload is abnormal (normal ping ~ 56B); sustained large echo from one src is a
# classic ICMP tunnel/exfil (Loki/icmptunnel). detection_filter 5/60s by_src tolerates
# the occasional jumbo diagnostic ping. Negative: normal small pings -> below bar.
alert icmp any any -> any any (msg:"PROTO-ANOMALY oversized ICMP echo payload - possible ICMP tunnel/exfil [medium]"; itype:8; dsize:>1024; detection_filter:track by_src, count 5, seconds 60; classtype:protocol-command-decode; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0011, mitre_tactic_name Command-and-Control, mitre_technique_id T1095, mitre_technique_name Non-Application-Layer-Protocol, kill_chain C2, confidence medium, signature_severity Major, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9500004_icmp-oversized-tunnel/poc.sh, tag icmp-tunnel, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9500004; rev:1;)
# FP-reasoning: HIGH, any, L3/L4, NON-payload. SYN and RST set together is an
# illegal TCP combination no legitimate stack emits -> attacker-unique scan/evasion.
# Single-event. Negative: a normal RST (connection reset, RST only) is legal -> silent.
alert tcp any any -> any any (msg:"PROTO-ANOMALY illegal TCP flags SYN+RST (scan/evasion) [high]"; flags:RS; classtype:protocol-command-decode; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1046, mitre_technique_name Network-Service-Discovery, kill_chain Recon, confidence high, signature_severity Minor, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9500005_tcp-syn-rst/poc.sh, tag tcp-flags-anomaly, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9500005; rev:1;)
# FP-reasoning: MEDIUM, any, L3/L4, NON-payload. A SYN-family segment carrying a
# data payload is abnormal (handshake SYN should be dataless); used for IDS evasion
# and some scanners. detection_filter 3/60s by_src tolerates the rare legitimate
# TCP-Fast-Open case. Negative: ONE SYN-with-data (decisive condition met once) but
# below the threshold -> silent.
alert tcp any any -> any any (msg:"PROTO-ANOMALY TCP SYN segment carrying data payload - evasion/TFO abuse [medium]"; flags:S; dsize:>0; detection_filter:track by_src, count 3, seconds 60; classtype:protocol-command-decode; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0005, mitre_tactic_name Defense-Evasion, mitre_technique_id T1205, mitre_technique_name Traffic-Signaling, kill_chain Delivery, confidence medium, signature_severity Minor, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9500006_tcp-syn-with-data/poc.sh, tag tcp-anomaly, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9500006; rev:1;)
# tcp/443 that Suricata's content-based app-layer detection classifies as NOT tls
# (plaintext HTTP / tunneled / C2 on the HTTPS port). detection_filter 3/60s by_src
# tolerates an occasional health-check/redirect probe. Negative: a real TLS
# ClientHello to :443 (app-layer=tls) exercises the SAME app-layer-protocol check
# and is correctly silent.
# FP-reasoning: MEDIUM, any. Decisive condition = Suricata's content-based
# app-layer parser sees a plaintext HTTP request whose destination port is 443
# (HTTPS port carrying cleartext HTTP = misconfig / tunneling / C2). Expressed as
# an `alert http ... -> any 443` rule (fires only when app-layer IS http on :443;
# the `app-layer-protocol` keyword does not match in a bare `alert tcp` form on
# 8.0.4). detection_filter 3/60s by_src tolerates an occasional probe/redirect.
# Negative: a real TLS ClientHello to :443 -> app-layer=tls, not http -> the rule
# never evaluates -> silent (decisive port/serving-context exercised).
alert http any any -> any 443 (msg:"PROTO-ANOMALY plaintext HTTP on tcp/443 - port/proto mismatch [medium]"; flow:established,to_server; http.method; bsize:>0; detection_filter:track by_src, count 3, seconds 60; classtype:protocol-command-decode; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0011, mitre_tactic_name Command-and-Control, mitre_technique_id T1571, mitre_technique_name Non-Standard-Port, kill_chain C2, confidence medium, signature_severity Major, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9500007_nontls-on-443/poc.sh, tag proto-mismatch, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9500007; rev:1;)
# FP-reasoning: MEDIUM, any, L3/L4, NON-payload. Decisive condition = a high rate
# of TCP RST from one source (RST-injection DoS, RST-scan, or spoofed teardown).
# threshold 40/10s by_src is the FP compensator: normal apps emit occasional RSTs;
# 40 in 10s from one src is anomalous. Negative: a handful of RSTs (normal aborts)
# exercises the same RST surface but is below threshold -> silent.
alert tcp any any -> any any (msg:"PROTO-ANOMALY high TCP RST rate from one source - reset flood/scan [medium]"; flags:R; threshold:type threshold, track by_src, count 40, seconds 10; classtype:attempted-dos; metadata: asset_category infra, owasp none, attack_target Server, mitre_tactic_id TA0040, mitre_tactic_name Impact, mitre_technique_id T1499, mitre_technique_name Endpoint-Denial-of-Service, kill_chain Actions-on-Objectives, confidence medium, signature_severity Major, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9500008_tcp-rst-flood/poc.sh, tag tcp-rst-flood, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9500008; rev:1;)
# FP-reasoning: MEDIUM, any (HTTP request method is cleartext). Decisive condition
# = HTTP TRACE request method. TRACE is disabled on virtually all modern servers
# and is used for Cross-Site-Tracing / recon; a real client almost never sends it.
# detection_filter 2/60s by_src tolerates a single uptime-monitor probe. Negative:
# a normal GET exercises the SAME http.method buffer but != TRACE -> silent.
alert http any any -> any any (msg:"PROTO-ANOMALY HTTP TRACE method (Cross-Site-Tracing / recon) [medium]"; flow:established,to_server; http.method; content:"TRACE"; nocase; detection_filter:track by_src, count 2, seconds 60; classtype:attempted-recon; metadata: asset_category web-mixed, owasp none, attack_target Server, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595, mitre_technique_name Active-Scanning, kill_chain Recon, confidence medium, signature_severity Minor, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9500009_http-trace-method/poc.sh, tag http-trace, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9500009; rev:1;)
