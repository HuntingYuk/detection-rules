# FP-reasoning: MEDIUM, network_mode=any. NON-payload (spec §22 C1): no fast_pattern.
# Variant 1 (9410001): single long high-entropy hex label. Variant 2 (9410002):
# oversized TOTAL query name (>=100 chars) — DNS tunneling chunks payload across
# many labels; legit qnames are almost always < 50. pcre bounded (qname max 253),
# single quantifier, no alternation -> no catastrophic backtracking (§19 D5).
# threshold count varies per variant = the FP compensator.
alert dns any any -> any any (msg:"DNS Tunnel - long high-entropy hex label in dns.query [medium]"; dns.query; pcre:"/(?:^|\.)[a-f0-9]{48,63}(?:\.|$)/i"; detection_filter:track by_src, count 15, seconds 60; classtype:trojan-activity; metadata: asset_category dns, owasp none, attack_target Server, mitre_tactic_id TA0011, mitre_tactic_name Command-and-Control, mitre_technique_id T1071.004, mitre_technique_name Application-Layer-Protocol-DNS, kill_chain C2, confidence medium, signature_severity Major, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9410001_long-hex-label/poc.sh, tag dns-tunnel, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9410001; rev:1;)
alert dns any any -> any any (msg:"DNS Tunnel - oversized query name (>=100 chars) [medium]"; dns.query; pcre:"/^.{100,}/"; threshold:type threshold, track by_src, count 10, seconds 60; classtype:trojan-activity; metadata: asset_category dns, owasp none, attack_target Server, mitre_tactic_id TA0011, mitre_tactic_name Command-and-Control, mitre_technique_id T1071.004, mitre_technique_name Application-Layer-Protocol-DNS, kill_chain C2, confidence medium, signature_severity Major, deployment Perimeter, network_mode any, cve none, poc_ref tests/poc/9410002_long-qname/poc.sh, tag dns-tunnel, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9410002; rev:1;)
