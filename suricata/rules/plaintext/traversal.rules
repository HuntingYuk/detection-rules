# FP-reasoning: HIGH, plain. Uses http.uri.RAW (Suricata normalises ../ out of
# http.uri, so raw is required). fast_pattern "etc/passwd" (attacker-shaped,
# selective). pcre requires a traversal token (../ or %2e%2e + sep) present ->
# directory-traversal read of /etc/passwd is attacker-unique. Bounded quantifier,
# no backtracking (§19 D5). Negative: a URI literally containing 'etc/passwd'
# (hits fast_pattern) but with NO traversal token -> reaches pcre, rejected -> silent.
alert http any any -> any any (msg:"WEB Path Traversal to /etc/passwd in http.uri.raw [high]"; flow:established,to_server; http.uri.raw; content:"etc/passwd"; nocase; fast_pattern; pcre:"/(?:\.\.|%2e%2e){1,8}(?:[\/\x5c]|%2f|%5c)/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0009, mitre_tactic_name Collection, mitre_technique_id T1083, mitre_technique_name File-and-Directory-Discovery, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9130001_dotdot-etc-passwd/poc.sh, tag path-traversal, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9130001; rev:1;)
# FP-reasoning: HIGH, plain. Variant 2 (9130002): PHP/stream-wrapper LFI/RFI.
# Scope http.uri.raw. fast_pattern "php://" + pcre requires a DANGEROUS wrapper
# (php://filter|input, data://, expect://, phar://, zip://) -> attacker-unique
# include-stream abuse. Negative: a docs URI with 'php://' but not a dangerous
# wrapper -> reaches pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"WEB LFI/RFI PHP stream wrapper (php://filter etc) in http.uri.raw [high]"; flow:established,to_server; http.uri.raw; content:"php://"; nocase; fast_pattern; pcre:"/(?:php:\/\/(?:filter|input|data)|data:\/\/text|expect:\/\/|phar:\/\/|zip:\/\/)/i"; classtype:web-application-attack; metadata: asset_category web-classic, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9130002_php-wrapper-lfi/poc.sh, tag lfi-wrapper, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9130002; rev:1;)
# FP-reasoning: HIGH, plain. Variant 4 (9130004): Windows path traversal to
# win.ini (9130001 is the *nix /etc/passwd target). Uses http.uri.RAW (../ is
# normalised out of http.uri). fast_pattern "win.ini" + pcre requires a
# traversal sequence (../ or ..\ raw or %2e%2e/%5c encoded) before it -> reading
# the Windows ini via traversal is attacker-unique. Bounded quantifiers. Negative:
# a help URI mentioning win.ini with NO traversal -> reaches pcre, rejected.
alert http any any -> any any (msg:"WEB Path Traversal to Windows win.ini in http.uri.raw [high]"; flow:established,to_server; http.uri.raw; content:"win.ini"; nocase; fast_pattern; pcre:"/(?:(?:\.\.|%2e%2e)(?:[\/\x5c]|%2f|%5c)){1,8}[^\r\n]{0,40}?win\.ini/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0009, mitre_tactic_name Collection, mitre_technique_id T1083, mitre_technique_name File-and-Directory-Discovery, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9130004_windows-win-ini/poc.sh, tag path-traversal, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9130004; rev:1;)
# FP-reasoning: HIGH, plain. Variant 5 (9130005): Unicode overlong-UTF-8
# traversal evasion (%c0%af and %c1%9c are RFC-3629 INVALID encodings of '/'
# and '\' — used to bypass naive %2f/%5c filters). Scope http.uri.raw. fast_
# pattern "%c0%af" (6B) -> RFC-invalid byte sequence; no legit URI emits it.
# pcre confirms it appears in a traversal-shaped context (preceded by .. or
# followed by a sensitive segment like etc/windows). Negative: a docs URI that
# mentions the literal %c0%af with no traversal -> reaches pcre, rejected.
alert http any any -> any any (msg:"WEB Path Traversal Unicode overlong-UTF-8 bypass (%c0%af/%c1%9c) in http.uri.raw [high]"; flow:established,to_server; http.uri.raw; content:"%c0%af"; nocase; fast_pattern; pcre:"/(?:(?:\.\.|%2e%2e)(?:%c0%af|%c1%9c)|%c0%af[^\r\n]{0,40}?(?:etc\/|windows[\/\x5c%]|passwd|win\.ini))/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0005, mitre_tactic_name Defense-Evasion, mitre_technique_id T1027, mitre_technique_name Obfuscated-Files-or-Information, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9130005_unicode-overlong-utf8/poc.sh, tag path-traversal, created_at 2026_05_20, updated_at 2026_05_20, author huntingyuk; sid:9130005; rev:1;)
# FP-reasoning: HIGH, plain. Variant 3 (9130003): double-URL-encoded traversal
# (%252e%252e -> ../ WAF/decoder bypass). Scope http.uri.raw. fast_pattern
# "%252e" -> double-encoded dot is attacker-unique (no benign URL double-encodes
# a path dot). pcre confirms the %252e%252e + sep sequence. Negative: a normal
# single-encoded %2e path -> no %252e fast_pattern hit -> silent.
# DEPRECATED 2026-05-19 sid:9130003 reason: OVERLAP audit §17: exact functional duplicate of ET Open 2019880 (Double Encoded Characters in URI ../) — mature equivalent, generic technique not part of the clean-room CVE backbone, no ET-independence rationale. Retired; benchmark/CI skip it.
# alert http any any -> any any (msg:"WEB Path Traversal double-URL-encoded (%252e%252e) in http.uri.raw [high]"; flow:established,to_server; http.uri.raw; content:"%252e"; nocase; fast_pattern; pcre:"/%252e%252e(?:%252f|%255c|\/)/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0009, mitre_tactic_name Collection, mitre_technique_id T1083, mitre_technique_name File-and-Directory-Discovery, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9130003_double-encoded/poc.sh, tag path-traversal, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9130003; rev:1;)
