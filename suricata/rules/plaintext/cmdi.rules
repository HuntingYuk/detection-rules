# FP-reasoning: MEDIUM, plain. Scope http.uri, to_server. fast_pattern
# "cat /etc/" (9B, attacker-shaped, NOT a hot generic token). pcre requires a
# SHELL SEPARATOR (; | & or backtick) immediately before cat\s+/etc/ -> command
# injection reading a sensitive file; legit URIs never carry [;|&`]cat /etc/.
# Bounded, no backtracking (§19 D5). Negative: a docs URI literally containing
# 'cat /etc/passwd' (hits fast_pattern) but with NO shell separator before it ->
# reaches the pcre and is rejected -> silent (strong negative, §19 T6).
alert http any any -> any any (msg:"WEB CMDi shell-separator + cat /etc/ in http.uri [medium]"; flow:established,to_server; http.uri; content:"cat /etc/"; nocase; fast_pattern; pcre:"/[\x3b\x7c\x26\x60]\s*cat\s+\/etc\//i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence medium, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9120001_shellsep-cat-etc/poc.sh, tag cmdi, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9120001; rev:1;)
# FP-reasoning: HIGH, plain. Variant 2 (9120002): bash reverse shell. Scope
# http.uri, to_server. fast_pattern "/dev/tcp/" -> the bash /dev/tcp/<host>/<port>
# reverse-shell idiom is attacker-unique; no benign request carries it. pcre
# requires a host+port after it. Negative: a docs URI mentioning '/dev/tcp/' as
# text (no host/port) -> hits fast_pattern, reaches pcre, rejected -> silent.
alert http any any -> any any (msg:"WEB CMDi bash reverse shell /dev/tcp/ in http.uri [high]"; flow:established,to_server; http.uri; content:"/dev/tcp/"; nocase; fast_pattern; pcre:"/\/dev\/tcp\/(?:\d{1,3}(?:\.\d{1,3}){3}|[a-z0-9.-]+)\/\d{1,5}/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9120002_bash-reverse-shell/poc.sh, tag cmdi-revshell, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9120002; rev:1;)
# FP-reasoning: MEDIUM, plain (SSTI; spec §22 D4 -> medium + computed probe).
# Scope http.uri. fast_pattern "{{7*7}}" -> the canonical Jinja/Twig template
# injection arithmetic probe; a benign request rarely carries the literal {{7*7}}.
# detection_filter 3/60s by_src. Other engines (${7*7}, <%=7*7%>, #{7*7}) =
# companion rules (roadmap). Negative: normal {{var}} templating -> no {{7*7}}
# fast_pattern hit -> silent.
alert http any any -> any any (msg:"WEB SSTI computed probe {{7*7}} (Jinja/Twig) in http.uri [medium]"; flow:established,to_server; http.uri; content:"{{7*7}}"; nocase; fast_pattern; pcre:"/\{\{\s*7\s*\*\s*7\s*\}\}/"; detection_filter:track by_src, count 3, seconds 60; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence medium, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9120003_ssti-computed-probe/poc.sh, tag ssti, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9120003; rev:1;)
# FP-reasoning: MEDIUM, plain. Variant 3 (9120004): PowerShell encoded-command
# injection. Scope http.uri. fast_pattern "powershell" + pcre requires the
# -e/-enc/-EncodedCommand flag followed by a long base64 blob -> attacker-shaped
# (legit traffic doesn't pass an encoded PS payload in a URL). detection_filter
# 3/60s by_src compensates the 'powershell' literal. Negative: a docs URL
# mentioning powershell without an encoded blob -> reaches pcre, rejected.
alert http any any -> any any (msg:"WEB CMDi PowerShell encoded command in http.uri [medium]"; flow:established,to_server; http.uri; content:"powershell"; nocase; fast_pattern; pcre:"/powershell(?:\.exe)?[^\r\n]{0,40}\s-e(?:c|nc|ncodedcommand)?\s+[A-Za-z0-9+\/=]{24,}/i"; detection_filter:track by_src, count 3, seconds 60; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence medium, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9120004_powershell-encoded/poc.sh, tag cmdi-powershell, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9120004; rev:1;)
# FP-reasoning: HIGH, plain. Variant 5 (9120005): Windows LOLBin download cradle
# (certutil -urlcache). Scope http.uri, to_server. fast_pattern "-urlcache" (9B,
# attacker-unique) -> the certutil download-cradle flag. pcre requires certutil
# + -urlcache + an http(s) URL within a bounded window -> a benign URL never
# carries a certutil file-download cradle -> deterministic, HIGH (§9). Negative:
# ?q=certutil -urlcache flag explained (prose, no http URL after) -> reaches
# pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"WEB CMDi Windows certutil -urlcache download cradle in http.uri [high]"; flow:established,to_server; http.uri; content:"-urlcache"; nocase; fast_pattern; pcre:"/certutil(?:\.exe)?(?:\s|%20|\+)[^\r\n]{0,40}-urlcache[^\r\n]{0,60}https?(?::|%3a)/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0011, mitre_tactic_name Command-and-Control, mitre_technique_id T1105, mitre_technique_name Ingress-Tool-Transfer, kill_chain Installation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9120005_certutil-download-cradle/poc.sh, tag cmdi-lolbin, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9120005; rev:1;)
# FP-reasoning: HIGH, plain. Variant 6 (9120006): Windows LOLBin download cradle
# (bitsadmin /transfer) -- complements 9120005 (certutil). Scope http.uri,
# to_server. fast_pattern "bitsadmin" + pcre requires the /transfer job + an
# http(s) URL in a bounded window -> a benign URL never carries a bitsadmin
# file-download cradle -> deterministic, HIGH (§9). Negative: ?q=bitsadmin
# /transfer syntax help (prose, no http URL) -> reaches pcre, rejected (§19 T6).
alert http any any -> any any (msg:"WEB CMDi Windows bitsadmin /transfer download cradle in http.uri [high]"; flow:established,to_server; http.uri; content:"bitsadmin"; nocase; fast_pattern; pcre:"/bitsadmin(?:\.exe)?(?:\s|%20|\+)[^\r\n]{0,60}\/transfer[^\r\n]{0,80}https?(?::|%3a)/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0011, mitre_tactic_name Command-and-Control, mitre_technique_id T1105, mitre_technique_name Ingress-Tool-Transfer, kill_chain Installation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9120006_bitsadmin-cradle/poc.sh, tag cmdi-lolbin, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9120006; rev:1;)
# FP-reasoning: HIGH, plain. Variant 7 (9120007): Windows LOLBin remote HTA
# execution (mshta http://...). Scope http.uri, to_server. fast_pattern "mshta"
# (5B) + pcre requires mshta + an http(s) URL ending in an HTA/HTM/JS payload
# within a bounded window -> a benign URL never carries mshta+remote-payload.
# Deterministic, HIGH (§9). Negative: ?q=mshta command syntax help (prose, no
# URL) -> reaches pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"WEB CMDi Windows mshta remote HTA execution in http.uri [high]"; flow:established,to_server; http.uri; content:"mshta"; nocase; fast_pattern; pcre:"/mshta(?:\.exe)?(?:\s|%20|\+)[^\r\n]{0,40}https?(?::|%3a)(?:\/\/|%2f%2f)[^\r\n]{0,80}\.(?:hta|html|htm|js)/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0011, mitre_tactic_name Command-and-Control, mitre_technique_id T1105, mitre_technique_name Ingress-Tool-Transfer, kill_chain Installation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9120007_mshta-remote-hta/poc.sh, tag cmdi-lolbin, created_at 2026_05_20, updated_at 2026_05_20, author huntingyuk; sid:9120007; rev:1;)
