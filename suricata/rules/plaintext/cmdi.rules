# FP-reasoning: MEDIUM, plain. Scope http.uri, to_server. fast_pattern
# "cat /etc/" (9B, attacker-shaped, NOT a hot generic token). pcre requires a
# SHELL SEPARATOR (; | & or backtick) immediately before cat\s+/etc/ -> command
# injection reading a sensitive file; legit URIs never carry [;|&`]cat /etc/.
# Bounded, no backtracking (§19 D5). Negative: a docs URI literally containing
# 'cat /etc/passwd' (hits fast_pattern) but with NO shell separator before it ->
# reaches the pcre and is rejected -> silent (strong negative, §19 T6).
alert http any any -> any any (msg:"WEB CMDi shell-separator + cat /etc/ in http.uri [medium]"; flow:established,to_server; http.uri; content:"cat /etc/"; nocase; fast_pattern; pcre:"/[\x3b\x7c\x26\x60]\s*cat\s+\/etc\//i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence medium, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9120001_shellsep-cat-etc/poc.sh, tag cmdi, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9120001; rev:1;)
# FP-reasoning: HIGH, plain. Variant 2 (9120002): bash reverse shell. Scope
# http.uri, to_server. fast_pattern "/dev/tcp/" -> the bash /dev/tcp/<host>/<port>
# reverse-shell idiom is attacker-unique; no benign request carries it. pcre
# requires a host+port after it. Negative: a docs URI mentioning '/dev/tcp/' as
# text (no host/port) -> hits fast_pattern, reaches pcre, rejected -> silent.
alert http any any -> any any (msg:"WEB CMDi bash reverse shell /dev/tcp/ in http.uri [high]"; flow:established,to_server; http.uri; content:"/dev/tcp/"; nocase; fast_pattern; pcre:"/\/dev\/tcp\/(?:\d{1,3}(?:\.\d{1,3}){3}|[a-z0-9.-]+)\/\d{1,5}/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9120002_bash-reverse-shell/poc.sh, tag cmdi-revshell, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9120002; rev:1;)
# FP-reasoning: MEDIUM, plain (SSTI; spec §22 D4 -> medium + computed probe).
# Scope http.uri. fast_pattern "{{7*7}}" -> the canonical Jinja/Twig template
# injection arithmetic probe; a benign request rarely carries the literal {{7*7}}.
# detection_filter 3/60s by_src. Other engines (${7*7}, <%=7*7%>, #{7*7}) =
# companion rules (roadmap). Negative: normal {{var}} templating -> no {{7*7}}
# fast_pattern hit -> silent.
alert http any any -> any any (msg:"WEB SSTI computed probe {{7*7}} (Jinja/Twig) in http.uri [medium]"; flow:established,to_server; http.uri; content:"{{7*7}}"; nocase; fast_pattern; pcre:"/\{\{\s*7\s*\*\s*7\s*\}\}/"; detection_filter:track by_src, count 3, seconds 60; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence medium, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9120003_ssti-computed-probe/poc.sh, tag ssti, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9120003; rev:1;)
