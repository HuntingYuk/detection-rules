# FP-reasoning: MEDIUM, plain. Scope http.uri, to_server. fast_pattern
# "cat /etc/" (9B, attacker-shaped, NOT a hot generic token). pcre requires a
# SHELL SEPARATOR (; | & or backtick) immediately before cat\s+/etc/ -> command
# injection reading a sensitive file; legit URIs never carry [;|&`]cat /etc/.
# Bounded, no backtracking (§19 D5). Negative: a docs URI literally containing
# 'cat /etc/passwd' (hits fast_pattern) but with NO shell separator before it ->
# reaches the pcre and is rejected -> silent (strong negative, §19 T6).
alert http any any -> any any (msg:"WEB CMDi shell-separator + cat /etc/ in http.uri [medium]"; flow:established,to_server; http.uri; content:"cat /etc/"; nocase; fast_pattern; pcre:"/[\x3b\x7c\x26\x60]\s*cat\s+\/etc\//i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence medium, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9120001_shellsep-cat-etc/poc.sh, tag cmdi, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9120001; rev:1;)
