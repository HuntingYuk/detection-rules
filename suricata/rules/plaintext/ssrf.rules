# FP-reasoning: HIGH, plain. Scope http.uri, to_server. fast_pattern
# "169.254.169.254" (the cloud link-local metadata IP -> attacker-unique as a
# request target). pcre requires it right after a scheme (://; raw or %3a%2f%2f) so
# a param VALUE pointing at the metadata service is the decisive condition.
# Negative: a doc/blog URI that merely mentions the IP as text (no scheme before
# it) hits fast_pattern, reaches pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"WEB SSRF to cloud metadata 169.254.169.254 in http.uri [high]"; flow:established,to_server; http.uri; content:"169.254.169.254"; fast_pattern; pcre:"/(?::\/\/|%3a%2f%2f)169\.254\.169\.254/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A10-SSRF, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1552, mitre_technique_name Unsecured-Credentials, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9150001_cloud-metadata-ip/poc.sh, tag ssrf-metadata, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9150001; rev:1;)
# FP-reasoning: HIGH, plain. Variant 2 (9150002): SSRF via dangerous URL scheme
# in a param. Scope http.uri. fast_pattern "gopher://" + pcre also catches
# dict/ldap/ftp/file scheme as a param VALUE (=scheme:// or %3a%2f%2f) ->
# attacker-unique (apps pass http(s) URLs, not gopher/dict/file). Negative: an
# http(s):// URL param -> no gopher fast_pattern hit -> silent.
alert http any any -> any any (msg:"WEB SSRF dangerous URL scheme (gopher/dict/file/ldap/ftp) in http.uri [high]"; flow:established,to_server; http.uri; content:"gopher://"; nocase; fast_pattern; pcre:"/(?:=|%3d|\x3a%2f%2f|:\/\/)?(?:gopher|dict|ldap|ftp|file|netdoc):(?:\/\/|%2f%2f)/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A10-SSRF, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1190, mitre_technique_name Exploit-Public-Facing-Application, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9150002_url-scheme-smuggling/poc.sh, tag ssrf-scheme, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9150002; rev:1;)
