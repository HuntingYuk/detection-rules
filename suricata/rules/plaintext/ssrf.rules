# FP-reasoning: HIGH, plain. Scope http.uri, to_server. fast_pattern
# "169.254.169.254" (the cloud link-local metadata IP -> attacker-unique as a
# request target). pcre requires it right after a scheme (://; raw or %3a%2f%2f) so
# a param VALUE pointing at the metadata service is the decisive condition.
# Negative: a doc/blog URI that merely mentions the IP as text (no scheme before
# it) hits fast_pattern, reaches pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"WEB SSRF to cloud metadata 169.254.169.254 in http.uri [high]"; flow:established,to_server; http.uri; content:"169.254.169.254"; fast_pattern; pcre:"/(?::\/\/|%3a%2f%2f)169\.254\.169\.254/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A10-SSRF, attack_target Server, mitre_tactic_id TA0006, mitre_tactic_name Credential-Access, mitre_technique_id T1552, mitre_technique_name Unsecured-Credentials, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9150001_cloud-metadata-ip/poc.sh, tag ssrf-metadata, created_at 2026_05_19, updated_at 2026_05_20, author huntingyuk; sid:9150001; rev:2;)
# FP-reasoning: HIGH, plain. Variant 2 (9150002): SSRF via dangerous URL scheme
# in a param. Scope http.uri. fast_pattern "gopher://" + pcre also catches
# dict/ldap/ftp/file scheme as a param VALUE (=scheme:// or %3a%2f%2f) ->
# attacker-unique (apps pass http(s) URLs, not gopher/dict/file). Negative: an
# http(s):// URL param -> no gopher fast_pattern hit -> silent.
alert http any any -> any any (msg:"WEB SSRF dangerous URL scheme (gopher/dict/file/ldap/ftp) in http.uri [high]"; flow:established,to_server; http.uri; content:"gopher://"; nocase; fast_pattern; pcre:"/(?:=|%3d|\x3a%2f%2f|:\/\/)?(?:gopher|dict|ldap|ftp|file|netdoc):(?:\/\/|%2f%2f)/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A10-SSRF, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1190, mitre_technique_name Exploit-Public-Facing-Application, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9150002_url-scheme-smuggling/poc.sh, tag ssrf-scheme, created_at 2026_05_19, updated_at 2026_05_20, author huntingyuk; sid:9150002; rev:2;)
# FP-reasoning: HIGH, plain. Variant 3 (9150003): SSRF to the GCP instance
# metadata service via its hostname metadata.google.internal (the bare-IP form is
# 9150001; the dangerous-scheme form is 9150002 -> this is the hostname GAP).
# Scope http.uri, to_server. fast_pattern "metadata.google.internal" is attacker-
# unique as a request target (no benign app fetches a user URL whose host is the
# cloud metadata endpoint). pcre requires it right after a scheme or a param '='
# so a doc page MENTIONING the hostname as path text is not enough. Negative: a
# URI /docs/metadata.google.internal-guide -> hits fast_pattern, reaches pcre (no
# :// or = immediately before) -> rejected -> silent (§19 T6).
alert http any any -> any any (msg:"WEB SSRF to GCP cloud metadata hostname metadata.google.internal in http.uri [high]"; flow:established,to_server; http.uri; content:"metadata.google.internal"; nocase; fast_pattern; pcre:"/(?::\/\/|%3a%2f%2f|=|%3d)metadata\.google\.internal/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A10-SSRF, attack_target Server, mitre_tactic_id TA0006, mitre_tactic_name Credential-Access, mitre_technique_id T1552, mitre_technique_name Unsecured-Credentials, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9150003_gcp-metadata-host/poc.sh, tag ssrf-metadata, created_at 2026_05_19, updated_at 2026_05_20, author huntingyuk; sid:9150003; rev:2;)
