# FP-reasoning: MEDIUM, canonical (unobfuscated) UNION SQLi only. Scope: http.uri,
# to_server. fast_pattern "union select" is a 12-byte composite literal (selective;
# NOT the bare hot "union"/"select" forbidden by CLAUDE.md §8). Structural pcre uses
# an ATOMIC group + bounded char-classes (no unbounded .* / no nested quantifier over
# alternation) -> no catastrophic backtracking (spec §19 D5). detection_filter
# count 3/60s by_src is the FP compensator: a single benign request that happens to
# contain "union select" (e.g. a user search) NEVER alerts; only scanner-like
# repetition from one source does. Obfuscated/url-other-encoded and "UNION ALL
# SELECT" variants are a separate companion rule (roadmap), deliberately not here.
alert http any any -> any any (msg:"WEB SQLi UNION-based in http.uri (canonical) [medium]"; flow:established,to_server; http.uri; content:"union select"; nocase; fast_pattern; pcre:"/\bunion\b(?:\s|%20|\+|(?>\/\*+[^*]*?\*+\/))++select\b/i"; detection_filter:track by_src, count 3, seconds 60; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1190, mitre_technique_name Exploit-Public-Facing-Application, kill_chain Exploitation, confidence medium, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9100001_union-select/poc.sh, tag sqli-union, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9100001; rev:1;)
# FP-reasoning: MEDIUM, plain. Variant 2 (9100002): TIME-BASED blind SQLi.
# Scope http.uri, to_server. fast_pattern "sleep(" + pcre requires a time
# primitive (SLEEP()/PG_SLEEP()/BENCHMARK()/WAITFOR DELAY) -> attacker-shaped.
# detection_filter 3/60s by_src compensates the hot 'sleep(' literal (a benign
# request rarely carries SQL sleep; scanners send many). Negative: a search for
# the word 'sleep' (no SQL time primitive) -> reaches pcre, rejected -> silent.
alert http any any -> any any (msg:"WEB SQLi time-based blind (SLEEP/BENCHMARK/WAITFOR) in http.uri [medium]"; flow:established,to_server; http.uri; content:"sleep("; nocase; fast_pattern; pcre:"/(?:sleep\(\s*\d|pg_sleep\(|benchmark\(\s*\d|waitfor\s+delay)/i"; detection_filter:track by_src, count 3, seconds 60; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1190, mitre_technique_name Exploit-Public-Facing-Application, kill_chain Exploitation, confidence medium, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9100002_time-based-blind/poc.sh, tag sqli-timebased, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9100002; rev:1;)
# FP-reasoning: MEDIUM, plain. Variant 3 (9100003): ERROR-based SQLi. Scope
# http.uri. fast_pattern "extractvalue(" + pcre for a MySQL/MSSQL error-extraction
# primitive (extractvalue/updatexml/exp(~(select/convert(int,(select). bounded.
# detection_filter 3/60s by_src. Negative: prose mentioning 'extractvalue' with no
# nested SELECT -> reaches pcre, rejected -> silent.
alert http any any -> any any (msg:"WEB SQLi error-based (extractvalue/updatexml/exp) in http.uri [medium]"; flow:established,to_server; http.uri; content:"extractvalue("; nocase; fast_pattern; pcre:"/(?:extractvalue\(\s*\d*\s*,|updatexml\(|exp\(\s*~\s*\(\s*select|convert\(\s*int\s*,\s*\(\s*select)/i"; detection_filter:track by_src, count 3, seconds 60; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1190, mitre_technique_name Exploit-Public-Facing-Application, kill_chain Exploitation, confidence medium, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9100003_error-based/poc.sh, tag sqli-errorbased, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9100003; rev:1;)
# FP-reasoning: MEDIUM, plain. Variant 4 (9100004): BOOLEAN-blind SQLi. Scope
# http.uri. fast_pattern "or 1=1" (composite, not a bare hot token). pcre requires
# a SQL tautology with a quote/paren boundary (' or '1'='1 / ) or (1=1 / or 1=1--)
# -> attacker-shaped. detection_filter 3/60s by_src compensates the literal.
# Negative: a benign search literally containing 'or 1=1' once (math text) ->
# below threshold -> silent.
alert http any any -> any any (msg:"WEB SQLi boolean-blind tautology in http.uri [medium]"; flow:established,to_server; http.uri; content:"or 1=1"; nocase; fast_pattern; pcre:"/(?:[\x27\x22]\s*\)?\s*or\s+[\x27\x22]?1[\x27\x22]?\s*=\s*[\x27\x22]?1|\bor\s+1\s*=\s*1\s*(?:--|#|\/\*|\)|\x3b|$))/i"; detection_filter:track by_src, count 3, seconds 60; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1190, mitre_technique_name Exploit-Public-Facing-Application, kill_chain Exploitation, confidence medium, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9100004_boolean-blind/poc.sh, tag sqli-boolean, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9100004; rev:1;)
