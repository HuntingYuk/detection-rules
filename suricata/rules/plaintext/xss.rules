# FP-reasoning: MEDIUM, plain. Scope http.uri, to_server. fast_pattern "><script"
# (8B composite, NOT the bare hot "<script" forbidden by §8). pcre requires a
# quote-then-> attribute breakout immediately before <script -> attacker-unique
# (legit URIs never carry ["']><script). Bounded, no backtracking (§19 D5).
# Single-event (the shape itself is the signal). Negative: a benign URI that merely
# contains the word <script (a docs search) -> does NOT hit the breakout
# fast_pattern -> silent.
alert http any any -> any any (msg:"WEB XSS attribute-breakout into <script> in http.uri [medium]"; flow:established,to_server; http.uri; content:"><script"; nocase; fast_pattern; pcre:"/[\x22\x27]>\s*<script/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence medium, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9110001_attr-breakout-script/poc.sh, tag xss-reflected, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9110001; rev:1;)
# FP-reasoning: MEDIUM, plain. Variant 2 (9110002): event-handler XSS. Scope
# http.uri. fast_pattern "onerror=" + pcre for an HTML on*-handler with an =
# (onerror/onload/onmouseover/onfocus/ontoggle) -> reflected-XSS shape. bounded.
# detection_filter 3/60s by_src compensates the handler literal. Negative: a URI
# mentioning 'onerror' in prose (no =) -> reaches pcre, rejected -> silent.
alert http any any -> any any (msg:"WEB XSS event-handler injection (on*=) in http.uri [medium]"; flow:established,to_server; http.uri; content:"onerror="; nocase; fast_pattern; pcre:"/\bon(?:error|load|mouseover|focus|toggle|animationstart)\s*=/i"; detection_filter:track by_src, count 3, seconds 60; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Client, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence medium, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9110002_event-handler/poc.sh, tag xss-reflected, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9110002; rev:1;)
# FP-reasoning: MEDIUM, plain. Variant 3 (9110003): JS/data-URI scheme XSS.
# Scope http.uri. fast_pattern "javascript:" + pcre also catches data:text/html
# and vbscript: as a reflected scheme. detection_filter 3/60s by_src compensates
# (javascript: legitimately appears in some links). Negative: one benign request
# mentioning javascript: -> below threshold -> silent.
alert http any any -> any any (msg:"WEB XSS javascript:/data: URI scheme in http.uri [medium]"; flow:established,to_server; http.uri; content:"javascript:"; nocase; fast_pattern; pcre:"/(?:javascript|data:text\/html|data:application\/x|vbscript)\s*:/i"; detection_filter:track by_src, count 3, seconds 60; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Client, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence medium, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9110003_js-scheme/poc.sh, tag xss-reflected, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9110003; rev:1;)
# FP-reasoning: MEDIUM, plain. Variant 4 (9110004): client-side template
# injection (AngularJS sandbox-escape). Scope http.uri. fast_pattern
# "constructor.constructor" (23B composite, NOT a hot token) -> the canonical
# CSTI sandbox-escape gadget; pcre requires it followed by a call/index so the
# phrase as JS-doc text does not alert. detection_filter 3/60s by_src is the FP
# compensator. Negative: a docs URI mentioning constructor.constructor as prose
# (no call) -> reaches pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"WEB XSS client-side template injection (AngularJS constructor.constructor) in http.uri [medium]"; flow:established,to_server; http.uri; content:"constructor.constructor"; nocase; fast_pattern; pcre:"/constructor(?:\.|%2e)constructor(?:\(|%28|\['|\[%22|%5b)/i"; detection_filter:track by_src, count 3, seconds 60; classtype:web-application-attack; metadata: asset_category web-modern, owasp A03-Injection, attack_target Client, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence medium, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9110004_angular-csti/poc.sh, tag xss-csti, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9110004; rev:1;)
# FP-reasoning: MEDIUM, plain. Variant 5 (9110005): reflected XSS via the
# <iframe srcdoc=> attribute (lets attacker embed HTML inside an attribute,
# bypassing sanitizers that only escape <script>). Scope http.uri. fast_pattern
# "iframe srcdoc=" (14B composite, NOT a hot bare token). pcre requires the
# srcdoc value to contain a script/handler payload so plain text in srcdoc
# does not alert. detection_filter 3/60s by_src compensates. Negative: a docs
# URI mentioning "iframe srcdoc=" with no payload -> reaches pcre, rejected.
