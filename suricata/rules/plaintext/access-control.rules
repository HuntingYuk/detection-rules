# FP-reasoning: HIGH, plain. Scope http.uri.raw, to_server. fast_pattern
# "/.git/config" -> probing an exposed Git repo config is attacker-unique; no
# legit client requests this path. (A05/exposure expressed under access-control:
# unauthenticated reach to a sensitive artefact.) Negative: a normal /api/config
# request -> no /.git/config -> silent.
alert http any any -> any any (msg:"WEB Exposure - /.git/config repository probe [high]"; flow:established,to_server; http.uri.raw; content:"/.git/config"; nocase; fast_pattern; classtype:attempted-recon; metadata: asset_category web-mixed, owasp A05-Security-Misconfiguration, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1083, mitre_technique_name File-and-Directory-Discovery, kill_chain Recon, confidence high, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9170001_git-config-exposure/poc.sh, tag exposure, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9170001; rev:1;)
# FP-reasoning: HIGH, plain. Variant 2 (9170002): cloud credential-file
# exposure probe. Scope http.uri.raw. fast_pattern "/.aws/credentials" ->
# requesting the AWS CLI credentials file over HTTP is attacker-unique; no
# benign client does this. Negative: a normal /aws/ API path -> no fast_pattern
# hit -> silent.
alert http any any -> any any (msg:"WEB Exposure - /.aws/credentials cloud secret probe [high]"; flow:established,to_server; http.uri.raw; content:"/.aws/credentials"; nocase; fast_pattern; classtype:attempted-recon; metadata: asset_category web-mixed, owasp A05-Security-Misconfiguration, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1083, mitre_technique_name File-and-Directory-Discovery, kill_chain Recon, confidence high, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9170002_aws-cred-exposure/poc.sh, tag exposure, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9170002; rev:1;)
# FP-reasoning: HIGH, plain. Variant 3 (9170003): SVN repo exposure probe
# (sibling of 9170001 /.git, 9170002 /.aws). Scope http.uri.raw. fast_pattern
# "/.svn/wc.db" -> requesting an SVN working-copy DB over HTTP is attacker-
# unique; no benign client requests this path. Negative: a normal /svn/ API
# path -> no fast_pattern hit -> silent.
alert http any any -> any any (msg:"WEB Exposure - /.svn/wc.db SVN repo probe [high]"; flow:established,to_server; http.uri.raw; content:"/.svn/wc.db"; nocase; fast_pattern; classtype:attempted-recon; metadata: asset_category web-mixed, owasp A05-Security-Misconfiguration, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1083, mitre_technique_name File-and-Directory-Discovery, kill_chain Recon, confidence high, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9170003_svn-wc-db-exposure/poc.sh, tag exposure, created_at 2026_05_20, updated_at 2026_05_20, author huntingyuk; sid:9170003; rev:1;)
# FP-reasoning: HIGH, plain. Variant 4 (9170004): exposed .env / dotfile
# config backup probe (sibling 9170001 .git, 9170002 .aws, 9170003 .svn).
# Scope http.uri.raw. fast_pattern "/.env" (5B) + pcre confirms the request
# is for a .env file or its common backups (.env.bak/.local/.backup/.production).
# No benign client requests dotfile env configs over HTTP. Negative: a normal
# /env/<something> API path -> no /.env fast_pattern hit -> silent.
alert http any any -> any any (msg:"WEB Exposure - /.env or config backup probe [high]"; flow:established,to_server; http.uri.raw; content:"/.env"; nocase; fast_pattern; pcre:"/\/\.env(?:\.(?:bak|backup|local|production|prod|dev|old|orig|save|swp))?(?:[\?\s\x00]|$)/i"; classtype:attempted-recon; metadata: asset_category web-mixed, owasp A05-Security-Misconfiguration, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1083, mitre_technique_name File-and-Directory-Discovery, kill_chain Recon, confidence high, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9170004_env-backup-exposure/poc.sh, tag exposure, created_at 2026_05_20, updated_at 2026_05_20, author huntingyuk; sid:9170004; rev:1;)
# FP-reasoning: HIGH, plain. Variant 5 (9170005): phpinfo() debug-page probe
# (sibling 9170001..4 — .git/.aws/.svn/.env). Scope http.uri.raw. fast_pattern
# "phpinfo" (7B; combined with the standard probe filenames in pcre = attacker
# -unique recon). pcre requires the canonical scanner paths: /phpinfo.php,
# /info.php, /test.php, /_profiler/phpinfo (Symfony), /phpinfo.html. 48 real-
# traffic hits in AUDIT-REALGAP. Negative: a benign /phpinfo-reference docs
# URL → no fast_pattern hit OR pcre rejects → silent.
alert http any any -> any any (msg:"WEB Exposure - phpinfo() debug page probe [high]"; flow:established,to_server; http.uri.raw; content:"phpinfo"; nocase; fast_pattern; pcre:"/\/(?:phpinfo(?:\.php|\.html)?|info\.php|test\.php|_profiler\/phpinfo|debug\.php)(?:[\?\#\s\x00]|$)/i"; classtype:attempted-recon; metadata: asset_category web-classic, owasp A05-Security-Misconfiguration, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1083, mitre_technique_name File-and-Directory-Discovery, kill_chain Recon, confidence high, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9170005_phpinfo-probe/poc.sh, tag exposure, created_at 2026_05_22, updated_at 2026_05_22, author huntingyuk; sid:9170005; rev:1;)
# FP-reasoning: HIGH, plain. Variant 6 (9170006): framework debug-page probe
# (Symfony _profiler / Laravel _ignition / Rails /rails/info — sibling of
# 9170005 phpinfo). Scope http.uri.raw. fast_pattern "_profiler" (Symfony
# web-profiler path; pcre's alternation also catches Laravel _ignition and
# Rails /rails/info canonical paths). No benign client requests these in
# production. Negative: a docs URL mentioning "_profiler" as text without
# the canonical path → pcre rejects → silent.
alert http any any -> any any (msg:"WEB Exposure - Symfony _profiler / Laravel _ignition / Rails /rails/info debug-page probe [high]"; flow:established,to_server; http.uri.raw; content:"_profiler"; nocase; fast_pattern; pcre:"/\/(?:_profiler(?:\/|\?|$)|_ignition\/(?:execute-solution|health-check)|rails\/info(?:\/(?:properties|routes))?(?:\/|\?|$))/i"; classtype:attempted-recon; metadata: asset_category web-modern, owasp A05-Security-Misconfiguration, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1083, mitre_technique_name File-and-Directory-Discovery, kill_chain Recon, confidence high, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9170006_framework-debug-probe/poc.sh, tag exposure, created_at 2026_05_22, updated_at 2026_05_22, author huntingyuk; sid:9170006; rev:1;)
# FP-reasoning: HIGH, plain. Variant 7 (9170007): Apache mod_status /
# mod_info probe (`/server-status`, `/server-info`) — leaks worker process
# table, requested URLs, internal IPs, vhost config; default-off but
# frequently mis-configured. Sibling of 9170001..6. Scope http.uri.raw.
# fast_pattern "/server-status" (14B; pcre also catches /server-info).
# pcre confirms canonical path + optional ?auto suffix. Negative: a docs
# URL mentioning "/server-status" → pcre rejects.
alert http any any -> any any (msg:"WEB Exposure - Apache mod_status /server-status /server-info probe [high]"; flow:established,to_server; http.uri.raw; content:"/server-status"; nocase; fast_pattern; pcre:"/\/server-(?:status|info)(?:\?(?:auto|refresh=\d+))?(?:[\?\#\s\x00]|$)/i"; classtype:attempted-recon; metadata: asset_category infra, owasp A05-Security-Misconfiguration, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1083, mitre_technique_name File-and-Directory-Discovery, kill_chain Recon, confidence high, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9170007_apache-server-status/poc.sh, tag exposure, created_at 2026_05_22, updated_at 2026_05_22, author huntingyuk; sid:9170007; rev:1;)
# FP-reasoning: HIGH, plain. Variant 8 (9170008): dependency-manifest
# exposure probe (sibling 9170001..7). Standard scanner recon for
# composer/npm/yarn/bower/Bundler/Maven/Gradle manifests left at web root.
# Scope http.uri.raw. fast_pattern "composer.json" (13B; the most common
# probe target). pcre's alternation broadens to all canonical manifests +
# lock files. Negative: a docs URL mentioning "composer.json" as text
# without the canonical path → pcre rejects.
alert http any any -> any any (msg:"WEB Exposure - dependency-manifest probe (composer/package/yarn/bower/Gemfile/pom/gradle) [high]"; flow:established,to_server; http.uri.raw; content:"composer.json"; nocase; fast_pattern; pcre:"/\/(?:composer\.(?:json|lock)|package(?:-lock)?\.json|yarn\.lock|bower\.json|Gemfile(?:\.lock)?|pom\.xml|build\.gradle(?:\.kts)?)(?:[\?\#\s\x00]|$)/i"; classtype:attempted-recon; metadata: asset_category web-modern, owasp A05-Security-Misconfiguration, attack_target Server, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1083, mitre_technique_name File-and-Directory-Discovery, kill_chain Recon, confidence high, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9170008_dep-manifest-probe/poc.sh, tag exposure, created_at 2026_05_23, updated_at 2026_05_23, author huntingyuk; sid:9170008; rev:1;)
