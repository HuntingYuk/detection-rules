# FP-reasoning: HIGH, plain. Scope http.request_body, to_server. fast_pattern
# "<!ENTITY" (attacker-shaped; appears only in DTDs). pcre requires an EXTERNAL
# entity (SYSTEM/PUBLIC + a fetchable scheme) -> XXE is attacker-unique. Bounded,
# no backtracking. Negative: a benign INTERNAL entity (<!ENTITY x "v">) hits the
# fast_pattern but has no SYSTEM/PUBLIC scheme -> reaches pcre, rejected -> silent.
alert http any any -> any any (msg:"WEB XXE external entity (SYSTEM/PUBLIC) in request body [high]"; flow:established,to_server; http.request_body; content:"<!ENTITY"; nocase; fast_pattern; pcre:"/<!ENTITY\s+\S+\s+(?:SYSTEM|PUBLIC)\s+[\x22\x27][^\x22\x27]*(?:file|https?|ftp|gopher|jar|netdoc|php|expect):/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0009, mitre_tactic_name Collection, mitre_technique_id T1213, mitre_technique_name Data-from-Information-Repositories, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9140001_doctype-entity-system/poc.sh, tag xxe, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9140001; rev:1;)
# FP-reasoning: HIGH, plain. Variant 2 (9140002): XXE parameter-entity OOB
# exfil. Scope http.request_body. fast_pattern "<!ENTITY %" + pcre requires the
# param entity to be SYSTEM (external DTD fetch) -> attacker-unique OOB pattern.
# Negative: a benign LOCAL parameter entity (<!ENTITY % x "v">, no SYSTEM) hits
# the fast_pattern, reaches pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"WEB XXE parameter-entity OOB (<!ENTITY % .. SYSTEM) in request body [high]"; flow:established,to_server; http.request_body; content:"<!ENTITY %"; nocase; fast_pattern; pcre:"/<!ENTITY\s+%\s+\S+\s+SYSTEM\s+[\x22\x27]/i"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0009, mitre_tactic_name Collection, mitre_technique_id T1213, mitre_technique_name Data-from-Information-Repositories, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9140002_param-entity-oob/poc.sh, tag xxe-oob, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9140002; rev:1;)
# FP-reasoning: MEDIUM, plain. Variant 3 (9140003): XML entity-expansion DoS
# (billion laughs). Scope http.request_body. fast_pattern "<!ENTITY" + pcre
# requires an entity DEFINED as >=2 references to another entity (the recursive
# amplifier) -> attacker-unique. pcre uses \x26 / \x3b (the &/; tokenizer trap,
# CLAUDE.md §5). Negative: a benign single-value internal entity -> hits
# fast_pattern, reaches pcre, rejected -> silent.
alert http any any -> any any (msg:"WEB XXE/DoS recursive entity expansion (billion laughs) in request body [high]"; flow:established,to_server; http.request_body; content:"<!ENTITY"; nocase; fast_pattern; pcre:"/<!ENTITY\s+\w+\s+[\x22\x27](?:\x26\w+\x3b\s*){2,}[\x22\x27]/i"; classtype:attempted-dos; metadata: asset_category web-mixed, owasp A03-Injection, attack_target Server, mitre_tactic_id TA0040, mitre_tactic_name Impact, mitre_technique_id T1499, mitre_technique_name Endpoint-Denial-of-Service, kill_chain Exploitation, confidence high, signature_severity Major, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9140003_billion-laughs/poc.sh, tag xxe-dos, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9140003; rev:1;)
