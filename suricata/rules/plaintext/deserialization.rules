# FP-reasoning: HIGH, plain. Scope http.request_body, to_server. fast_pattern
# "rO0AB" = base64 of the Java serialization magic AC ED 00 05 00 -> attacker-
# unique header of a serialized object stream in an HTTP body/param (insecure
# deserialization / ysoserial). Anchored, bounded. Negative: a benign base64 blob
# that does NOT start with the Java magic -> no fast_pattern hit -> silent.
alert http any any -> any any (msg:"WEB Insecure Deserialization - Java serialized object (base64 rO0AB) in request body [high]"; flow:established,to_server; http.request_body; content:"rO0AB"; fast_pattern; pcre:"/rO0AB[A-Za-z0-9+\/]{8,}/"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A08-Software-and-Data-Integrity-Failures, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9160001_java-serialized-b64/poc.sh, tag deserialization, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9160001; rev:1;)
# FP-reasoning: HIGH, plain. Variant 2 (9160002): .NET insecure deserialization
# (ysoserial.net gadgets). Scope http.request_body. fast_pattern
# "ObjectDataProvider" + pcre for a known .NET gadget type -> attacker-unique in
# an HTTP body. Negative: a normal body (no gadget type) -> no fast_pattern hit ->
# silent.
alert http any any -> any any (msg:"WEB Insecure Deserialization - .NET ysoserial gadget in request body [high]"; flow:established,to_server; http.request_body; content:"ObjectDataProvider"; nocase; fast_pattern; pcre:"/(?:ObjectDataProvider|ExpandedWrapperOf|TypeConfuseDelegate|WindowsIdentity|ResourceDictionary|PSObject)/"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A08-Software-and-Data-Integrity-Failures, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9160002_dotnet-ysoserial/poc.sh, tag deserialization, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9160002; rev:1;)
# FP-reasoning: HIGH, plain. Variant 3 (9160003): Node.js node-serialize
# unserialize() RCE. Scope http.request_body. fast_pattern "_$$ND_FUNC$$_" ->
# the node-serialize function marker; attacker-unique, no benign JSON contains
# it. pcre confirms the IIFE function payload. Negative: a normal JSON body ->
# no fast_pattern hit -> silent.
alert http any any -> any any (msg:"WEB Insecure Deserialization - Node.js node-serialize RCE marker in body [high]"; flow:established,to_server; http.request_body; content:"_$$ND_FUNC$$_"; fast_pattern; pcre:"/_\$\$ND_FUNC\$\$_[^\r\n]*function\s*\(/i"; classtype:web-application-attack; metadata: asset_category web-modern, owasp A08-Software-and-Data-Integrity-Failures, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9160003_node-serialize-rce/poc.sh, tag deserialization, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9160003; rev:1;)
# FP-reasoning: HIGH, plain. Variant 4 (9160004): Python object injection via an
# unsafe YAML/PyYAML load. Scope http.request_body, to_server. fast_pattern
# "!!python/" -> the PyYAML language tag that drives object construction; no
# benign JSON/form/YAML data payload carries a !!python/object tag. pcre confirms
# an object/module/apply/new construction tag. Negative: a body that contains
# "!!python/" as prose but no object/module tag after it -> reaches pcre,
# rejected -> silent (§19 T6).
alert http any any -> any any (msg:"WEB Insecure Deserialization - Python YAML object injection (!!python/object) in request body [high]"; flow:established,to_server; http.request_body; content:"!!python/"; nocase; fast_pattern; pcre:"/!!python\/(?:object\/(?:apply|new)|object|module)[\x3a\/]/i"; classtype:web-application-attack; metadata: asset_category web-modern, owasp A08-Software-and-Data-Integrity-Failures, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9160004_python-yaml-objinject/poc.sh, tag deserialization, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9160004; rev:1;)
# FP-reasoning: HIGH, plain. Variant 5 (9160005): raw .NET BinaryFormatter /
# LosFormatter serialized stream. Scope http.request_body, to_server.
# fast_pattern "AAEAAAD/////" = base64 of the BinaryFormatter header
# 00 01 00 00 00 FF FF FF FF (3-byte aligned from the blob start, §5) ->
# attacker-unique magic; distinct from the .NET XML/text gadget rule 9160002.
# pcre requires more base64 after the magic (a real stream, not the literal
# token). Negative: a body that contains AAEAAAD///// as prose with no base64
# tail -> reaches pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"WEB Insecure Deserialization - .NET BinaryFormatter serialized stream (base64 AAEAAAD) in request body [high]"; flow:established,to_server; http.request_body; content:"AAEAAAD/////"; fast_pattern; pcre:"/AAEAAAD\/\/\/\/\/[A-Za-z0-9+\/]{16,}/"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A08-Software-and-Data-Integrity-Failures, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9160005_dotnet-binaryformatter/poc.sh, tag deserialization, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9160005; rev:1;)
# FP-reasoning: HIGH, plain. Variant 6 (9160006): Ruby unsafe YAML (Psych)
# object injection. Scope http.request_body, to_server. fast_pattern
# "!ruby/object" -> the Psych YAML language tag that instantiates arbitrary
# Ruby objects (Universal gadget -> RCE); no benign data payload carries it.
# pcre confirms the tag is followed by a ':' (a real type tag, not prose).
# Negative: a body that mentions "!ruby/object" as advice text with no ':' ->
# reaches pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"WEB Insecure Deserialization - Ruby YAML object injection (!ruby/object) in request body [high]"; flow:established,to_server; http.request_body; content:"!ruby/object"; nocase; fast_pattern; pcre:"/!ruby\/(?:object|hash|struct|class|sym)(?::|%3a)/i"; classtype:web-application-attack; metadata: asset_category web-modern, owasp A08-Software-and-Data-Integrity-Failures, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9160006_ruby-yaml-objinject/poc.sh, tag deserialization, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9160006; rev:1;)
# FP-reasoning: HIGH, plain. Variant 7 (9160007): PHP object-injection POP chain
# using the well-known Monolog gadget family (Laravel/Symfony stacks). Scope
# http.request_body, to_server. fast_pattern "Monolog|5c|Handler" -> a serialized
# PHP object whose class is Monolog\Handler\... is attacker-shaped (no benign
# app posts that class graph). pcre requires the surrounding PHP serialized-
# object structure O:NN:"Monolog\Handler\X" so the class name as advice text
# does not alert. Negative: body mentioning Monolog\Handler as prose (no O:NN:")
# -> reaches pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"WEB Insecure Deserialization - PHP object injection Monolog POP chain (O:NN:\"Monolog\\Handler\\...\") in request body [high]"; flow:established,to_server; http.request_body; content:"Monolog|5c|Handler"; nocase; fast_pattern; pcre:"/O:\d{1,3}:\x22Monolog\x5c(?:Handler|Formatter|Logger)\x5c[A-Za-z0-9_]{3,60}\x22/i"; classtype:web-application-attack; metadata: asset_category web-classic, owasp A08-Software-and-Data-Integrity-Failures, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9160007_php-monolog-pop/poc.sh, tag deserialization, created_at 2026_05_20, updated_at 2026_05_20, author huntingyuk; sid:9160007; rev:1;)
