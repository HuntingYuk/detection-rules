# FP-reasoning: HIGH, plain. Scope http.request_body, to_server. fast_pattern
# "rO0AB" = base64 of the Java serialization magic AC ED 00 05 00 -> attacker-
# unique header of a serialized object stream in an HTTP body/param (insecure
# deserialization / ysoserial). Anchored, bounded. Negative: a benign base64 blob
# that does NOT start with the Java magic -> no fast_pattern hit -> silent.
alert http any any -> any any (msg:"WEB Insecure Deserialization - Java serialized object (base64 rO0AB) in request body [high]"; flow:established,to_server; http.request_body; content:"rO0AB"; fast_pattern; pcre:"/rO0AB[A-Za-z0-9+\/]{8,}/"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A08-Software-and-Data-Integrity-Failures, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9160001_java-serialized-b64/poc.sh, tag deserialization, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9160001; rev:1;)
# FP-reasoning: HIGH, plain. Variant 2 (9160002): .NET insecure deserialization
# (ysoserial.net gadgets). Scope http.request_body. fast_pattern
# "ObjectDataProvider" + pcre for a known .NET gadget type -> attacker-unique in
# an HTTP body. Negative: a normal body (no gadget type) -> no fast_pattern hit ->
# silent.
alert http any any -> any any (msg:"WEB Insecure Deserialization - .NET ysoserial gadget in request body [high]"; flow:established,to_server; http.request_body; content:"ObjectDataProvider"; nocase; fast_pattern; pcre:"/(?:ObjectDataProvider|ExpandedWrapperOf|TypeConfuseDelegate|WindowsIdentity|ResourceDictionary|PSObject)/"; classtype:web-application-attack; metadata: asset_category web-mixed, owasp A08-Software-and-Data-Integrity-Failures, attack_target Server, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command-and-Scripting-Interpreter, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve none, poc_ref tests/poc/9160002_dotnet-ysoserial/poc.sh, tag deserialization, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9160002; rev:1;)
