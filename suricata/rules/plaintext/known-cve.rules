# exploited by ransomware ops late 2024). Clean-room from advisory. Two-
# buffer: http.uri.raw "/Synchronization" (fast_pattern; the Cleo sync
# endpoint targeted by the exploit) + http.request_body pcre requires the
# autorun-path-traversal marker (../autorun/ or ../autorun%2f, where the
# uploaded file is auto-executed by Cleo's host). Negative: a normal Cleo
# /Synchronization request without traversal → body pcre rejects → silent.
alert http any any -> any any (msg:"KNOWN-CVE Cleo Harmony/VLTrader unauth file-upload RCE (CVE-2024-50623) [high]"; flow:established,to_server; http.uri.raw; content:"/Synchronization"; nocase; fast_pattern; http.request_body; pcre:"/(?:\.\.|%2e%2e)(?:\/|%2f)autorun(?:\/|%2f)|host=[^&\r\n]{0,200}autorun(?:\/|%2f)/i"; classtype:attempted-admin; metadata: asset_category infra, owasp A06-Vulnerable-and-Outdated-Components, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1190, mitre_technique_name Exploit-Public-Facing-Application, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve CVE-2024-50623, poc_ref tests/poc/9300046_cleo-cve-2024-50623/poc.sh, tag cleo, created_at 2026_05_21, updated_at 2026_05_21, author huntingyuk; sid:9300046; rev:1;)
# FP-reasoning: HIGH, plain. CVE-2021-44228 Log4Shell — obfuscated JNDI
# bypass variants (the bare-string rule 9300001 catches "${jndi:<scheme>:";
# real exploit traffic in 2021-2025 uses string-substitution tricks like
# "${::-j}${::-n}${::-d}${::-i}:" and "${env:UNDEFINED:-jndi}:" to evade
# naive matchers). Scope http.header (UA/Referer/Cookie/X-Forwarded-For/
# Authorization — same as 9300001). fast_pattern "${::-" (5B; the ::-
# default-value substitution is an attacker-unique opener — no benign
# log4j config uses it). pcre confirms either a "j" letter substitution
# right after, OR the ${env: + jndi pattern. Negative: an HTTP header
# mentioning "${::-" as text without a JNDI letter substitution after
# → reaches pcre, rejected → silent.
alert http any any -> any any (msg:"KNOWN-CVE Log4Shell obfuscated JNDI bypass (${::-} or ${env:...:-jndi}) in HTTP header (CVE-2021-44228) [high]"; flow:established,to_server; http.header; content:"${::-"; nocase; fast_pattern; pcre:"/\$\{(?:::-[jJ]|env\x3a[^}]{0,40}?:-(?:jndi|jnd\$\{))/i"; classtype:attempted-admin; metadata: asset_category web-mixed, owasp A06-Vulnerable-and-Outdated-Components, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1190, mitre_technique_name Exploit-Public-Facing-Application, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve CVE-2021-44228, poc_ref tests/poc/9300047_log4shell-obfuscated/poc.sh, tag log4shell, created_at 2026_05_21, updated_at 2026_05_21, author huntingyuk; sid:9300047; rev:1;)
# FP-reasoning: HIGH, plain. ThinkPHP 5.x RCE — the framework's _method
# field + invokefunction route abuse executes arbitrary PHP callables.
# Mass-scanned by botnets (86 hits across 3 MTA scan-and-probe pcaps,
# AUDIT-REALGAP). Clean-room from public advisories. Scope http.uri.raw.
# fast_pattern "invokefunction" -> the canonical exploit URL marker;
# attacker-unique (no benign ThinkPHP URL contains it). pcre confirms the
# function= + vars[]= gadget shape calling a dangerous primitive. Negative:
# a docs URI mentioning "invokefunction" with no &function= gadget ->
# reaches pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"KNOWN-CVE ThinkPHP invokefunction route RCE (CVE-2018-20062) [high]"; flow:established,to_server; http.uri.raw; content:"invokefunction"; nocase; fast_pattern; pcre:"/(?:s=|\/)[^\r\n]{0,60}?invokefunction[^\r\n]{0,80}?function=[^\r\n]{0,30}?(?:system|exec|passthru|shell_exec|phpinfo|assert|eval|file_get_contents|call_user_func)/i"; classtype:attempted-admin; metadata: asset_category web-classic, owasp A06-Vulnerable-and-Outdated-Components, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1190, mitre_technique_name Exploit-Public-Facing-Application, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve CVE-2018-20062, poc_ref tests/poc/9300048_thinkphp-invokefunction/poc.sh, tag thinkphp, created_at 2026_05_22, updated_at 2026_05_22, author huntingyuk; sid:9300048; rev:1;)
# FP-reasoning: HIGH, plain. CVE-2018-10561 GPON home-gateway auth-bypass +
# command-injection (Dasan/Realtek-based ISP CPEs — heavily Mirai-recruited).
# Clean-room from advisory. Scope http.uri.raw. fast_pattern "/GponForm/
# diag_Form" (the auth-bypass endpoint; the trick is appending "?images/"
# suffix which the router parses as a static file but reaches the action
# handler). pcre confirms images/ bypass OR dest_host injection param.
# Negative: a normal /GponForm path without the images/ bypass and without
# metachar in dest_host -> reaches pcre, rejected.
