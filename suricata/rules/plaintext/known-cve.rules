# FP-reasoning: high-confidence. Literal "${jndi:" is a selective 7-byte fast_pattern
# (not a hot literal) and, followed by a real JNDI scheme, is attacker-unique: no
# benign HTTP request carries "${jndi:<scheme>:". The negative sends "${jndi:" with
# NO scheme so it reaches the pcre and is rejected there (strong negative, spec T6).
alert http any any -> any any (msg:"KNOWN-CVE Log4Shell JNDI lookup in HTTP header (CVE-2021-44228) [high]"; flow:established,to_server; http.header; content:"${jndi:"; nocase; fast_pattern; pcre:"/\$\{jndi:(?:ldaps?|rmi|dns|iiop|nis|corba|nds|https?)\:/i"; classtype:attempted-admin; metadata: asset_category web-mixed, owasp A06-Vulnerable-and-Outdated-Components, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1190, mitre_technique_name Exploit-Public-Facing-Application, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve CVE-2021-44228, poc_ref tests/poc/9300001_log4shell-jndi/poc.sh, tag log4shell, created_at 2026_05_18, updated_at 2026_05_18, author huntingyuk; sid:9300001; rev:1;)
