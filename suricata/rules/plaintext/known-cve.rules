# FP-reasoning: HIGH, plain. CVE-2023-4966 "Citrix Bleed" NetScaler/Gateway
# session-token memory leak. Clean-room from advisory. The OIDC discovery
# endpoint /oauth/idp/.well-known/openid-configuration is itself legitimate, so
# fast_pattern on that URI alone would FP; the decisive condition is that same
# request carrying an ABNORMALLY long Host header (the exploit pads Host to
# ~24KB to over-read memory). Two buffers: uri.raw literal (fast_pattern) +
# http.header pcre requiring a >=200-char Host value. A real OIDC discovery has
# a short Host -> reaches the header pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"KNOWN-CVE Citrix Bleed NetScaler session-token leak oversized Host (CVE-2023-4966) [high]"; flow:established,to_server; http.uri.raw; content:"/oauth/idp/.well-known/openid-configuration"; nocase; fast_pattern; http.header; pcre:"/Host\x3a\x20*[^\r\n]{200,4096}/i"; classtype:attempted-admin; metadata: asset_category infra, owasp A06-Vulnerable-and-Outdated-Components, attack_target Server, mitre_tactic_id TA0006, mitre_tactic_name Credential-Access, mitre_technique_id T1212, mitre_technique_name Exploitation-for-Credential-Access, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve CVE-2023-4966, poc_ref tests/poc/9300029_citrixbleed-cve-2023-4966/poc.sh, tag citrixbleed, created_at 2026_05_19, updated_at 2026_05_19, author huntingyuk; sid:9300029; rev:1;)
# FP-reasoning: HIGH, plain. CVE-2021-26855 MS Exchange ProxyLogon (SSRF auth
# bypass — precursor to ProxyShell 9300009 which we already cover). Clean-room
# from advisory. Scope http.cookie. fast_pattern "X-AnonResource-Backend" (21B)
# -> the SSRF cookie name carrying a backend target is the canonical exploit
# marker; no benign client sends it. pcre confirms it carries a backend path
# (/ecp/ or /owa/). Negative: the cookie present but pointing at a benign value
# (no /ecp//owa/) -> reaches pcre, rejected -> silent (§19 T6).
alert http any any -> any any (msg:"KNOWN-CVE MS Exchange ProxyLogon SSRF X-AnonResource-Backend cookie (CVE-2021-26855) [high]"; flow:established,to_server; http.cookie; content:"X-AnonResource-Backend"; nocase; fast_pattern; pcre:"/X-AnonResource-Backend\s*=\s*[^\r\n\x3b]{0,120}\/(?:ecp|owa)\//i"; classtype:attempted-admin; metadata: asset_category infra, owasp A06-Vulnerable-and-Outdated-Components, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1190, mitre_technique_name Exploit-Public-Facing-Application, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve CVE-2021-26855, poc_ref tests/poc/9300030_exchange-proxylogon/poc.sh, tag proxylogon, created_at 2026_05_20, updated_at 2026_05_20, author huntingyuk; sid:9300030; rev:1;)
# FP-reasoning: HIGH, plain. CVE-2019-15107 Webmin pre-auth command injection
# via the password-change endpoint. Clean-room from advisory. Two-buffer:
# http.uri.raw content "/password_change.cgi" (fast_pattern; attacker-targeted
# unauth endpoint) + http.request_body pcre requires a shell metachar in the
# 'old=' param value -> the bug passed that value to perl_exec. Negative: a
# legit POST to the endpoint with benign 'old=' (no metachar) -> reaches body
# pcre, rejected -> silent (§19 T6).
