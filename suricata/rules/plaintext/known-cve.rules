# rejects → silent.
alert http any any -> any any (msg:"KNOWN-CVE WordPress Bricks Builder render_element RCE (CVE-2024-25600) [high]"; flow:established,to_server; http.uri.raw; content:"/wp-json/bricks/v1/render_element"; nocase; fast_pattern; http.request_body; pcre:"/queryEditor[\s\S]{0,200}?(?:eval|file_get_contents|phpinfo|passthru|system|shell_exec|assert)\s*\(/i"; classtype:attempted-admin; metadata: asset_category web-classic, owasp A06-Vulnerable-and-Outdated-Components, attack_target Server, mitre_tactic_id TA0001, mitre_tactic_name Initial-Access, mitre_technique_id T1190, mitre_technique_name Exploit-Public-Facing-Application, kill_chain Exploitation, confidence high, signature_severity Critical, deployment Perimeter, network_mode plain, cve CVE-2024-25600, poc_ref tests/poc/9300045_wp-bricks-rce/poc.sh, tag wordpress, created_at 2026_05_21, updated_at 2026_05_21, author huntingyuk; sid:9300045; rev:1;)
